# The web app as static files under /app (built with that base): hashed assets cached for good,
# the page never (a cached page after a deploy asks for assets the new image no longer has), and
# everything else falls back to the app.
:8080 {
	encode zstd gzip
	redir /app /app/
	handle_path /app/* {
		root * /srv
		@page not path /assets/*
		header @page Cache-Control "no-cache"
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}
