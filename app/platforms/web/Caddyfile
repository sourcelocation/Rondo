# The web app as static files under /app (built with that base): hashed assets cached for good,
# the page never (a cached page after a deploy asks for assets the new image no longer has), and
# everything else under /app falls back to the app.
#
# In production the ingress sends only /app here. With server/compose.yaml this is the front door,
# routing by path as the ingress does (and Vite in development): the Go server, the sync server, Kratos
# without the prefix (and without the Origin and Cookie headers browsers add, as the apps' sign-in is
# headless) and Hydra. Share links lead into the app; the docs stay on Rondo's site.
:8080 {
	encode zstd gzip

	redir / /app/
	redir /d/* /app{uri}
	redir /i/* /app{uri}
	redir /u/* /app{uri}
	redir /redeem /app{uri}
	redir /redeem/* /app{uri}
	redir /docs* https://rondo.matthewsource.com{uri}

	redir /app /app/
	handle_path /app/* {
		root * /srv
		@page not path /assets/*
		header @page Cache-Control "no-cache"
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}

	@api path /api/* /media/* /blobs/*
	handle @api {
		reverse_proxy api:8080
	}
	@sync path /sync/* /mcp /.well-known/oauth-protected-resource*
	handle @sync {
		reverse_proxy sync:8081
	}
	handle_path /auth/* {
		reverse_proxy kratos:4433 {
			header_up -Origin
			header_up -Cookie
		}
	}
	@hydra path /oauth2/* /userinfo /.well-known/openid-configuration /.well-known/oauth-authorization-server /.well-known/jwks.json
	handle @hydra {
		reverse_proxy hydra:4444
	}
	handle {
		respond 404
	}
}
