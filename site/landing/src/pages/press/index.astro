---
import ArrowDownToLine from "@lucide/astro/icons/arrow-down-to-line";
import ArrowUpRight from "@lucide/astro/icons/arrow-up-right";
import Check from "@lucide/astro/icons/check";
import Copy from "@lucide/astro/icons/copy";
import X from "@lucide/astro/icons/x";
import Scenery from "../../components/Scenery.astro";
import Footer from "../../components/Footer.astro";
import Logo from "../../components/Logo.astro";
import Nav from "../../components/Nav.astro";
import { links } from "../../content/links";
import { about, curves, facts, palette, screenshots, typefaces } from "../../content/press";
import Page from "../../layouts/Page.astro";

/**
 * The press kit and the brand, in one: for writers, the words to quote and the facts; for anyone making
 * something with Rondo, the logo (made from the brand's artwork, src/press.ts), the colours, the type and the motion,
 * each shown working; screenshots once there are some; and who to write to. Its motion is motion/press.ts.
 */
const logos = [
  { name: "Logo", note: "The mark and the wordmark", files: ["rondo-logo.svg", "rondo-logo.png"], ground: "paper" },
  {
    name: "Logo, reversed",
    note: "For dark backgrounds",
    files: ["rondo-logo-reversed.svg", "rondo-logo-reversed.png"],
    ground: "ink",
  },
  {
    name: "Mark",
    note: "Where there's no room for the word",
    files: ["rondo-mark.svg", "rondo-mark.png"],
    ground: "paper",
  },
  {
    name: "Mark, reversed",
    note: "The mark on dark",
    files: ["rondo-mark-reversed.svg", "rondo-mark-reversed.png"],
    ground: "ink",
  },
  {
    name: "App icon",
    note: "As the apps wear it",
    files: ["rondo-app-icon.svg", "rondo-app-icon.png"],
    ground: "light",
  },
] as const;
const misuses = [
  { name: "Stretched", kind: "stretch" },
  { name: "Recoloured", kind: "colour" },
  { name: "Turned", kind: "turn" },
  { name: "Decorated", kind: "effects" },
] as const;
---

<Page
  title="Press & brand · Rondo"
  description="Rondo's press kit and brand: the logo, screenshots, words to quote, colours, type and motion."
>
  <Scenery />
  <Nav />
  <main class="press" id="main">
    <section class="opening" aria-labelledby="press-title" data-mood="hero">
      <h1 id="press-title" class="visually-hidden">
        Press &amp; brand
      </h1>

      <div class="container">
        <figure class="build" aria-hidden="true" data-build data-reveal="rise">
          <div class="build__frame">
            <i class="build__line build__line--top" data-build-line></i>
            <i class="build__line build__line--bottom" data-build-line></i>
            <i class="build__line build__line--seam" data-build-line></i>
            <i class="build__space" data-build-box></i>
            <i class="build__box" data-build-box></i>
            <span class="build__logo" data-build-logo>
              <Logo />
            </span>
            <span class="build__measure build__measure--height" data-build-note>
              x
            </span>
            <span class="build__measure build__measure--room" data-build-note>
              ½x
            </span>
          </div>
          <figcaption class="build__caption" data-build-note>
            Half the logo’s height of room, all round
          </figcaption>
        </figure>
        <div class="opening__actions" data-reveal="fade">
          <a class="button button--solid" href="/press/rondo-press-kit.zip" download data-magnetic>
            <ArrowDownToLine class="button__icon" aria-hidden="true" stroke-width={2} />
            <span class="button__label">
              <span>Download the kit</span>
              <span aria-hidden="true">Download the kit</span>
            </span>
          </a>
          <a class="button button--glass" href={`mailto:${links.email}`} data-magnetic>
            <span class="button__label">
              <span>Write to the maker</span>
              <span aria-hidden="true">Write to the maker</span>
            </span>
            <ArrowUpRight class="button__arrow" aria-hidden="true" stroke-width={1.75} />
          </a>
        </div>
      </div>
    </section>

    <section class="section brief" aria-labelledby="brief-title" data-mood="source">
      <div class="container brief__grid">
        <div class="brief__words">
          <h2 id="brief-title" class="heading" data-reveal="words">
            Words to <em>quote.</em>
          </h2>
          <div class="quote" data-reveal="fade">
            <div class="quote__head">
              <p class="quote__title">In a sentence</p>
              <button class="copy" type="button" data-copy="#quote-sentence">
                <Copy class="copy__icon" aria-hidden="true" />
                <Check class="copy__done" aria-hidden="true" />
                <span class="copy__label roll" data-copy-label>
                  <span>Copy</span>
                </span>
              </button>
            </div>
            <p class="quote__text" id="quote-sentence">
              {about.sentence}
            </p>
          </div>
          <div class="quote" data-reveal="fade">
            <div class="quote__head">
              <p class="quote__title">In a paragraph</p>
              <button class="copy" type="button" data-copy="#quote-paragraph">
                <Copy class="copy__icon" aria-hidden="true" />
                <Check class="copy__done" aria-hidden="true" />
                <span class="copy__label roll" data-copy-label>
                  <span>Copy</span>
                </span>
              </button>
            </div>
            <p class="quote__text" id="quote-paragraph">
              {about.paragraph} <span data-when="pre">{about.launch.pre}</span>
              <span data-when="live">{about.launch.live}</span>
            </p>
          </div>
        </div>
        <dl class="sheet" data-reveal="fade">
          {facts.map((fact) => (
            <div class="sheet__row">
              <dt>{fact.term}</dt>
              <dd>
                {fact.href != null ? (
                  <a class="link" href={fact.href}>
                    {fact.value}
                  </a>
                ) : (
                  fact.value
                )}
              </dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <section class="section marks" aria-labelledby="marks-title" data-mood="sync">
      <div class="container">
        <div class="part__head">
          <h2 id="marks-title" class="heading" data-reveal="words">
            The mark, <em>and the word.</em>
          </h2>
          <p class="lead" data-reveal="lines">
            A bookmark with an arrow turning back through it, beside the name in Juana. It’s one colour: ink on light
            grounds, and reversed on dark.
          </p>
        </div>
        <ul class="logos">
          {logos.map((item) => (
            <li class:list={["logo-card", `logo-card--${item.ground}`]} data-reveal="fade" data-spotlight>
              <span class="logo-card__light" aria-hidden="true"></span>
              <div class="logo-card__view">
                <img src={`/press/${item.files[0]}`} alt={`Rondo’s ${item.name.toLowerCase()}`} loading="lazy" />
              </div>
              <div class="logo-card__foot">
                <p>
                  <b>{item.name}</b>
                  <span>{item.note}</span>
                </p>
                <span class="logo-card__files">
                  {item.files.map((file) => (
                    <a class="file" href={`/press/${file}`} download>
                      {file.split(".").at(-1)?.toUpperCase()}
                    </a>
                  ))}
                </span>
              </div>
            </li>
          ))}
        </ul>
        <div class="misuse">
          <p class="misuse__title" data-reveal="fade">
            Please don’t recolour, stretch, turn or outline it, or add effects.
          </p>
          <ul class="misuse__list">
            {misuses.map((misuse) => (
              <li class="misuse__item" data-reveal="fade">
                <span class:list={["misuse__logo", `misuse__logo--${misuse.kind}`]} aria-hidden="true">
                  <Logo />
                </span>
                <span class="misuse__name">
                  <X aria-hidden="true" stroke-width={2.25} />
                  {misuse.name}
                </span>
              </li>
            ))}
          </ul>
          <p class="misuse__note" data-reveal="fade">
            The Rondo name, mark and logo are trademarks of the Rondo project and aren’t covered by the AGPL-3.0: use
            them to refer to Rondo. A fork needs a name and a mark of its own.
          </p>
        </div>
      </div>
    </section>

    <section class="section colours" aria-labelledby="colours-title" data-mood="anki">
      <div class="container">
        <div class="part__head">
          <h2 id="colours-title" class="heading" data-reveal="words">
            Ink, paper, <em>and light.</em>
          </h2>
          <p class="lead" data-reveal="lines">
            Choose a colour to copy it.
          </p>
        </div>
        {palette.map((group) => (
          <div class="palette">
            <p class="palette__head" data-reveal="fade">
              <b>{group.title}</b>
              {group.note}
            </p>
            <ul class="palette__swatches">
              {group.swatches.map((swatch) => (
                <li data-reveal="fade">
                  <button
                    class:list={["swatch", { "swatch--dark": swatch.dark }]}
                    type="button"
                    data-swatch={swatch.hex}
                    aria-label={`Copy ${swatch.name}, ${swatch.hex}`}
                  >
                    <span class="swatch__colour" data-colour={swatch.name.toLowerCase()}></span>
                    <span class="swatch__name">{swatch.name}</span>
                    <span class="swatch__hex roll" data-copy-label>
                      <span>{swatch.hex}</span>
                    </span>
                    {swatch.use != null && <span class="swatch__use">{swatch.use}</span>}
                  </button>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <section class="section type" aria-labelledby="type-title" data-mood="apps">
      <div class="container">
        <div class="part__head">
          <h2 id="type-title" class="heading" data-reveal="words">
            A serif to feel, <em>a sans to read.</em>
          </h2>
        </div>
        <ul class="faces">
          {typefaces.map((face) => (
            <li
              class:list={["face", `face--${face.family}`]}
              data-reveal="fade"
              data-weight={face.family === "sans" ? "" : undefined}
            >
              <span class="face__glyphs" aria-hidden="true">
                Aa
              </span>
              <p class="face__sample">{face.sample}</p>
              <div class="face__about">
                <b>{face.name}</b>
                <span>{face.role}</span>
                <span>{face.weights}</span>
              </div>
              {face.family === "sans" && (
                <span class="face__weight" aria-hidden="true" data-weight-value>
                  400
                </span>
              )}
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="section moves" aria-labelledby="moves-title" data-mood="ai">
      <div class="container">
        <div class="part__head">
          <h2 id="moves-title" class="heading" data-reveal="words">
            Things settle; <em>nothing snaps.</em>
          </h2>
          <p class="lead" data-reveal="lines">
            Rondo moves on three curves. Things come in out of a soft blur, settle rather than stop, and land with a
            little give.
          </p>
        </div>
        <ul class="curves">
          {curves.map((curve) => (
            <li class="curve" data-reveal="fade">
              <div class="curve__plot" aria-hidden="true">
                <svg class="curve__graph" viewBox="0 0 100 100" preserveAspectRatio="none">
                  <path class="curve__axis" d="M 0 0 V 100 H 100"></path>
                  <path class="curve__path" d={curve.path}></path>
                </svg>
                <span class="curve__dot">
                  <i data-ease={curve.variable}></i>
                </span>
              </div>
              <span class="curve__track" aria-hidden="true">
                <i data-ease={curve.variable}></i>
              </span>
              <p class="curve__about">
                <b>{curve.name}</b>
                <code>{curve.variable}</code>
                <span>{curve.use}</span>
              </p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="section shots" aria-labelledby="shots-title" data-mood="faq">
      <div class="container">
        <div class="part__head">
          <h2 id="shots-title" class="heading" data-reveal="words">
            Rondo, <em>on every screen.</em>
          </h2>
          <p class="lead" data-reveal="lines">
            Screenshots of Rondo's native apps
          </p>
        </div>
        <ul class="shots__grid">
          {screenshots.map((shot) => (
            <li class:list={["shot", `shot--${shot.shape}`]} data-reveal="fade">
              <div class="shot__frame" aria-hidden="true">
                <Logo mark />
              </div>
              <p class="shot__about">
                <b>{shot.device}</b> · {shot.screen}
              </p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="write" aria-labelledby="write-title" data-mood="closing">
      <div class="container write__inner">
        <h2 id="write-title" class="write__title" data-reveal="words">
          Writing about <em>Rondo?</em>
        </h2>
        <a class="write__email" href={`mailto:${links.email}`} data-reveal="fade">
          {links.email}
        </a>
        <p class="lead" data-reveal="lines">
          Or find the maker on{" "}
          <a class="link" href={links.x}>
            X
          </a>
          , or in the{" "}
          <a class="link" href={links.discord}>
            Discord
          </a>
          .
        </p>
      </div>
    </section>
  </main>
  <Footer />
</Page>

<script>
  import { build, copy, swatch, weight } from "../../motion/press";
  import { scene } from "../../motion/scenes";
  import { spotlight } from "../../motion/spotlight";

  scene("[data-build]", build);
  scene("[data-copy]", copy);
  scene("[data-swatch]", swatch);
  scene("[data-weight]", weight);
  scene("[data-spotlight]", (card, stage) => {
    if (stage.fine) spotlight([card]);
  });
</script>

<style>
  .press {
    position: relative;
    z-index: 1;
    overflow-x: clip;
  }

  /* The opening: the logo as it's built, its guides drawn in. */
  .opening {
    padding-top: calc(var(--nav) + clamp(48px, 1.5rem + 4vw, 104px));
  }

  .write__title em {
    font-family: var(--serif);
    font-style: normal;
    font-weight: 300;
    letter-spacing: -0.035em;
  }

  .opening__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: clamp(24px, 1rem + 1.4vw, 40px);
  }

  .build {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 22px;
    margin: 0;
    padding: clamp(48px, 8vw, 104px) 24px clamp(28px, 4vw, 44px);
    border-radius: 32px;
    overflow: hidden;
    background: linear-gradient(180deg, rgb(255 255 255 / 76%), rgb(255 255 255 / 52%));
    box-shadow:
      0 0 0 1px var(--line),
      0 1px 0 var(--glass-edge) inset,
      var(--shadow-2);
    -webkit-backdrop-filter: blur(24px) saturate(1.5);
    backdrop-filter: blur(24px) saturate(1.5);
  }

  /*
   * The logo sits in its room (--x is its height; the room is half that all round); the guides run along its top
   * and its foot, across the whole panel, and down where the mark meets the word.
   */
  .build__frame {
    --x: clamp(52px, 9vw, 132px);
    position: relative;
    padding: calc(var(--x) / 2);
    font-size: var(--x);
    line-height: 0;
  }

  .build__logo {
    position: relative;
    display: block;
    color: var(--ink);
  }

  .build__space,
  .build__box {
    position: absolute;
    border-radius: 4px;
    pointer-events: none;
  }

  .build__space {
    inset: 0;
    border: 1px dashed rgb(111 143 255 / 55%);
    background: repeating-linear-gradient(45deg, rgb(111 143 255 / 6%) 0 6px, transparent 6px 12px);
  }

  .build__box {
    inset: calc(var(--x) / 2);
    border: 1px solid rgb(111 143 255 / 70%);
  }

  /* The guides: along the logo's top and foot, across the panel, and down where the mark meets the word. */
  .build__line {
    position: absolute;
    left: -60vw;
    right: -60vw;
    height: 1px;
    background: rgb(111 143 255 / 40%);
  }

  .build__line--top {
    top: calc(var(--x) / 2);
  }

  .build__line--bottom {
    top: calc(var(--x) * 1.5);
  }

  /* The mark's crop is 293 of the logo's 302 high (brand.ts), so the word starts there. */
  .build__line--seam {
    top: -60svh;
    bottom: -60svh;
    left: calc(var(--x) / 2 + var(--x) * 293 / 302);
    right: auto;
    width: 1px;
    height: auto;
  }

  .build__measure {
    position: absolute;
    font: 500 13px / 1 var(--mono);
    color: #4d6fe0;
  }

  .build__measure--height {
    left: calc(var(--x) / 2 - 26px);
    top: 50%;
    translate: 0 -50%;
  }

  .build__measure--room {
    left: calc(var(--x) / 4);
    top: calc(var(--x) / 4);
    translate: -50% -50%;
  }

  .build__caption {
    position: relative;
    font-size: var(--size-small);
    color: var(--ink-3);
  }

  .part__head {
    display: grid;
    justify-items: start;
    gap: clamp(18px, 0.85rem + 0.7vw, 26px);
    max-width: 44em;
    margin-bottom: clamp(40px, 1.5rem + 2.5vw, 64px);
  }

  .part__head .lead {
    max-width: 34em;
  }

  /* In brief: the words to quote, and the facts beside them. */
  .brief__grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(40px, 6vw, 104px);
    align-items: start;
  }

  .brief__words {
    display: grid;
    justify-items: start;
    gap: clamp(20px, 1rem + 0.6vw, 28px);
  }

  .quote {
    display: grid;
    gap: 12px;
    width: 100%;
    padding: 22px 24px 24px;
    border-radius: 24px;
    background: linear-gradient(180deg, rgb(255 255 255 / 78%), rgb(255 255 255 / 56%));
    box-shadow:
      0 0 0 1px var(--line),
      0 1px 0 var(--glass-edge) inset,
      var(--shadow-1);
  }

  .quote__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .quote__title {
    font-size: var(--size-small);
    font-weight: 500;
    color: var(--ink-3);
  }

  .quote__text {
    font-size: var(--size-lead);
    line-height: 1.55;
    letter-spacing: -0.012em;
    text-wrap: pretty;
  }

  /* A copy button: its label rolls to "Copied", the icon turning to a tick. */
  .copy {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 32px;
    padding: 0 12px 0 10px;
    border-radius: 999px;
    background: rgb(11 11 13 / 5%);
    font-size: 13px;
    font-weight: 500;
    color: var(--ink-2);
    transition:
      background-color 0.4s var(--ease-out),
      color 0.4s var(--ease-out);
  }

  .copy:hover {
    background: var(--ink);
    color: var(--paper);
  }

  .copy :global(svg) {
    width: 14px;
    height: 14px;
  }

  .copy :global(.copy__done) {
    display: none;
    color: var(--signal);
  }

  .copy.is-copied :global(.copy__icon) {
    display: none;
  }

  .copy.is-copied :global(.copy__done) {
    display: block;
  }

  .sheet {
    display: grid;
    margin: 0;
    border-top: 1px solid var(--line-2);
  }

  .sheet__row {
    display: grid;
    grid-template-columns: 7.5em 1fr;
    gap: 16px;
    padding: 16px 0;
    border-bottom: 1px solid var(--line-2);
    font-size: 15px;
  }

  .sheet__row dt {
    color: var(--ink-3);
  }

  .sheet__row dd {
    margin: 0;
    color: var(--ink);
  }

  /* The logo's files, each shown on the ground it's for. */
  .logos {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 16px;
  }

  .logo-card {
    --x: 50%;
    --y: 0%;
    position: relative;
    display: grid;
    grid-template-rows: 1fr auto;
    grid-column: span 2;
    min-height: 300px;
    border-radius: 28px;
    overflow: hidden;
    isolation: isolate;
    box-shadow:
      0 0 0 1px var(--line),
      var(--shadow-1);
  }

  .logo-card:nth-child(-n + 2) {
    grid-column: span 3;
  }

  .logo-card--paper {
    background: #f2efe7;
  }

  .logo-card--ink {
    background: #0b0b0d;
    color: #fff;
  }

  .logo-card--light {
    background:
      radial-gradient(60% 70% at 20% 20%, rgb(169 202 255 / 70%), transparent 70%),
      radial-gradient(60% 70% at 85% 80%, rgb(255 203 180 / 70%), transparent 70%), #fbfbfd;
  }

  .logo-card__light {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(360px circle at var(--x) var(--y), rgb(255 255 255 / 30%), transparent 60%);
    opacity: 0;
    transition: opacity 0.6s var(--ease-out);
  }

  .logo-card:hover .logo-card__light {
    opacity: 1;
  }

  .logo-card__view {
    display: grid;
    place-items: center;
    padding: 40px;
  }

  .logo-card__view img {
    width: auto;
    max-width: 70%;
    max-height: 120px;
    transition: transform 1s var(--ease-spring);
  }

  .logo-card:hover .logo-card__view img {
    transform: scale(1.05);
  }

  .logo-card__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 16px 18px 18px;
  }

  .logo-card__foot p {
    display: grid;
    font-size: 14px;
  }

  .logo-card__foot b {
    font-weight: 500;
  }

  .logo-card__foot p span {
    color: var(--ink-3);
  }

  .logo-card--ink .logo-card__foot p span {
    color: rgb(255 255 255 / 60%);
  }

  .logo-card__files {
    display: flex;
    gap: 6px;
  }

  .file {
    display: inline-grid;
    place-items: center;
    height: 30px;
    padding: 0 12px;
    border-radius: 999px;
    background: rgb(11 11 13 / 7%);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: inherit;
    text-decoration: none;
    transition:
      background-color 0.4s var(--ease-out),
      color 0.4s var(--ease-out);
  }

  .file:hover {
    background: var(--ink);
    color: var(--paper);
  }

  .logo-card--ink .file {
    background: rgb(255 255 255 / 12%);
  }

  .logo-card--ink .file:hover {
    background: #fff;
    color: var(--ink);
  }

  .misuse {
    display: grid;
    gap: 20px;
    margin-top: clamp(48px, 1.75rem + 2.5vw, 80px);
  }

  .misuse__title {
