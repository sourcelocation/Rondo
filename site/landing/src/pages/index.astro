---
import Anki from "../components/Anki.astro";
import Assistants from "../components/Assistants.astro";
import Scenery from "../components/Scenery.astro";
import Closing from "../components/Closing.astro";
import Collection from "../components/Collection.astro";
import Faq from "../components/Faq.astro";
import Flight from "../components/Flight.astro";
import Footer from "../components/Footer.astro";
import Hero from "../components/Hero.astro";
import Maker from "../components/Maker.astro";
import Nav from "../components/Nav.astro";
import Platforms from "../components/Platforms.astro";
import Source from "../components/Source.astro";
import Page from "../layouts/Page.astro";
---

<Page title="Rondo — Free, open-source flashcards">
  <Scenery />
  <Nav animated />
  <main class="main" id="main">
    <Hero />
    <Collection />
    <Platforms />
    <Flight />
    <Anki />
    <Assistants />
    <Source />
    <Maker />
    <Faq />
    <Closing />
  </main>
  <Footer />
</Page>

<style>
  .main {
    position: relative;
    z-index: 1;
    overflow-x: clip;
  }
</style>
