---
import Anki from "../components/Anki.astro";
import Aurora from "../components/Aurora.astro";
import Closing from "../components/Closing.astro";
import Footer from "../components/Footer.astro";
import Hero from "../components/Hero.astro";
import Intro from "../components/Intro.astro";
import Maker from "../components/Maker.astro";
import Nav from "../components/Nav.astro";
import Platforms from "../components/Platforms.astro";
import Source from "../components/Source.astro";
import Sync from "../components/Sync.astro";
import Page from "../layouts/Page.astro";
---

<Page title="Rondo — Free, open-source flashcards">
  <Aurora />
  <Intro />
  <Nav animated />
  <main class="main" id="main">
    <Hero />
    <Anki />
    <Source />
    <Sync />
    <Platforms />
    <Maker />
    <Closing />
  </main>
  <Footer />
</Page>

<script>
  import "../motion/main";
</script>

<style>
  .main {
    position: relative;
    z-index: 1;
    overflow-x: clip;
  }
</style>
