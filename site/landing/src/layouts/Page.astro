---
/** A page of the site: plain HTML until the landing page is designed. */
interface Props {
  title: string;
  description?: string;
}

const { title, description = "Rondo — spaced repetition that comes back around." } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
