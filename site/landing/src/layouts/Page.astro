---
import "../styles/base.css";
import geist from "../../../../brand/fonts/geist/Geist-Variable.woff2?url";
import juana from "../../../../brand/fonts/juana/Juana-Light.otf?url";
import Curtain from "../components/Curtain.astro";
import Intro from "../components/Intro.astro";
import Sprite from "../components/Sprite.astro";
import { releaseAt } from "../launch/launch";

/**
 * A page of the site: its head, the type and the base styles, the artwork for the page to use, the intro a page
 * opens with and the curtain between pages, and the motion every page runs (motion/page.ts), which brings to life
 * whatever scenes the page's components declare, and where their drawings put what's on them (/places.css). It's
 * built as Rondo is at build time, on a computer; /head.js corrects both before it paints. The screen's probe, never seen, is how the motion measures the screen as CSS has it
 * (motion/screen.ts).
 */
interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Rondo is a free, open-source flashcard app with everything you rely on in Anki: native on every device, in sync online or off.",
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en" data-release={releaseAt(Date.now())} data-os="web" data-device="desktop">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <script is:inline src="/head.js"></script>
    <link rel="stylesheet" href="/places.css" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#ffffff" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Rondo" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL("/og.png", Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="The Rondo logo on soft, pastel light" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={geist} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={juana} as="font" type="font/otf" crossorigin />
  </head>
  <body>
    <a class="skip" href="#main">
      Skip to content
    </a>
    <Sprite />
    <div class="screen" aria-hidden="true" data-screen>
      <i data-screen-safe></i>
    </div>
    <slot />
    <Curtain />
    <Intro />
    <script>
      import "../motion/page";
    </script>
  </body>
</html>

<style>
  /* The screen's probe: as wide as the screen, as tall as it is with the toolbars away, and inside, with them out. */
  .screen {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: var(--screen);
    visibility: hidden;
    pointer-events: none;
  }

  .screen i {
    display: block;
    height: var(--screen-safe);
  }
</style>
