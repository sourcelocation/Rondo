---
import { Image } from "astro:assets";
import opening from "../assets/flight/opening.webp";
import openingTall from "../assets/flight/opening-tall.webp";
import rest from "../assets/flight/rest.webp";
import restTall from "../assets/flight/rest-tall.webp";
import { links } from "../content/links";

/**
 * Offline, and in sync: a film of an airliner skimming the cloud tops, white in the page's pastel light, drawn by the
 * scenery behind the page and played by the scroll (motion/flight.ts). The section is the film's timeline, laid out:
 * a stage a screen tall, which holds the screen while the track under it scrolls past, and a still end. It opens on
 * the plane's business cabin, seen from a little ahead, with the words above the clouds over the sky; as the page
 * scrolls the camera swings in through a window, turns to the laptop on the empty seat's table, and settles there,
 * Rondo in airplane mode, under the words of landing, which come up over the cabin. The film fades into the page
 * above and below. Its posters, drawn by the film itself at twice the pixels, stand in until it plays: its opening
 * shot, full screen (16:10, and 1:2 for phones), so it takes over from them seamlessly; and, without motion, where it
 * would have come to rest (2:1, and 4:5), the words then laid out above and below it.
 */
---

<section class="flight" id="offline" aria-labelledby="offline-title" data-mood="sync" data-flight>
  <div class="flight__stage" data-flight-stage>
    <div class="container flight__copy flight__copy--above" data-flight-above>
      <h2 id="offline-title" class="heading" data-reveal="words">
        No Wi-Fi?
      </h2>
    </div>

    <div class="flight__film" aria-hidden="true" data-flight-film>
      {/* The posters: the film's opening shot and its last, framed for wide screens and for tall ones. */}
      <Image
        class="flight__poster flight__poster--wide"
        src={opening}
        alt=""
        widths={[960, 1440, 1920, 2880]}
        sizes="100vw"
        loading="lazy"
      />
      <Image
        class="flight__poster flight__poster--tall"
        src={openingTall}
        alt=""
        widths={[540, 1080]}
        sizes="100vw"
        loading="lazy"
      />
      <Image
        class="flight__poster flight__poster--rest"
        src={rest}
        alt=""
        widths={[960, 1440, 1920, 2880]}
        sizes="100vw"
        loading="lazy"
      />
      <Image
        class="flight__poster flight__poster--rest-tall"
        src={restTall}
        alt=""
        widths={[540, 1080]}
        sizes="100vw"
        loading="lazy"
      />
    </div>

    <div class="container flight__copy flight__copy--landed" data-flight-landed>
      <p class="heading">
        <em>It works offline too</em>
      </p>
      <p class="lead">
        Everything lives on your device, so Rondo never needs a connection to study, edit or import. Back online, it
        syncs in the background, and every answer from every device counts.
      </p>
      <p class="flight__more">
        <a class="link" href={`${links.docs}sync`}>
          How sync works
        </a>
      </p>
    </div>
  </div>

  <div class="flight__track" data-flight-track></div>
</section>

<script>
  import { FlightFilm } from "../motion/flight";
  import { scene } from "../motion/scenes";

  scene("[data-flight]", (host, stage) => new FlightFilm(host, stage));
</script>

<style>
  /*
   * The film's timeline, laid out in screens: the stage, then the track the camera flies along while the stage holds
   * the screen, and a still end (::after), to read by.
   */
  .flight {
    position: relative;
  }

  .flight__track {
    height: calc(var(--screen) * 3.86);
  }

  .flight::after {
    content: "";
    display: block;
    height: calc(var(--screen) * 0.36);
  }

  /*
   * The screen the film holds: the scenery draws it here, behind the words, where the posters stand in until then. As
   * tall as the screen with the toolbars away, as the scenery is, so they come and go over it.
   */
  .flight__stage {
    position: sticky;
    top: 0;
    height: var(--screen);
    overflow: hidden;
  }

  /*
   * The words, over the film's top: its sky at the opening, the cabin above the laptop at rest, both faded into the
   * page there. The film frames the laptop under them (motion/flight/film.ts).
   */
  .flight__copy {
    position: absolute;
    inset-inline: 0;
    top: calc(var(--nav) + clamp(24px, 0.5rem + 3.2vw, 72px));
    z-index: 1;
    display: grid;
    justify-items: center;
    gap: clamp(16px, 0.75rem + 0.8vw, 28px);
    text-align: center;
  }

  .flight__copy .heading {
    max-width: 14em;
  }

  .flight__copy .lead {
    max-width: 34em;
  }

  .flight__more {
    font-size: var(--size-small);
    color: var(--ink-2);
  }

  /*
   * The film: the whole stage, its top fading into the page under the words, and its foot into the page below: clear
   * down to --fade-clear, solid from --fade-solid to --fade-foot, then clear again by the foot. The scenery fades the
   * film it draws here by the same (motion/scenery/projection.ts reads them).
   */
  .flight__film {
    --fade-clear: 6%;
    --fade-solid: 42%;
    --fade-foot: 86%;
    position: absolute;
    inset: 0;
    -webkit-mask-image: linear-gradient(
      to bottom,
      transparent var(--fade-clear),
      #000 var(--fade-solid),
      #000 var(--fade-foot),
      transparent
    );
    mask-image: linear-gradient(
      to bottom,
      transparent var(--fade-clear),
      #000 var(--fade-solid),
      #000 var(--fade-foot),
      transparent
    );
  }

  /* Once the film has a frame, drawn behind them, the posters fade away over it. */
  .flight__poster {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition:
      opacity 1.4s var(--ease-out),
      visibility 0s;
  }

  .flight__poster--tall,
  .flight__poster--rest,
  .flight__poster--rest-tall {
    display: none;
  }

  .flight.is-playing .flight__poster {
    opacity: 0;
    visibility: hidden;
    transition-delay: 0s, 1.4s;
  }

  @media (width < 760px) {
    .flight__poster--wide {
      display: none;
    }

    .flight__poster--tall {
      display: block;
    }
  }

  /*
   * Without motion the film doesn't play: the section is as tall as it is, its words above and below the poster of
   * where the film would have come to rest.
   */
  @media (prefers-reduced-motion: reduce) {
    .flight {
      padding-top: var(--section);
    }

    .flight__track,
    .flight::after {
      display: none;
    }

    .flight__stage {
      position: static;
      height: auto;
      display: grid;
      gap: clamp(24px, 1rem + 2vw, 48px);
    }

    .flight__copy {
      position: static;
    }

    .flight__film {
      --fade-clear: 0%;
      --fade-solid: 18%;
      --fade-foot: 84%;
      position: relative;
      height: clamp(440px, 50vw, var(--screen-safe) * 0.88);
    }

    .flight__poster--wide,
    .flight__poster--tall {
      display: none;
    }

    .flight__poster--rest {
      display: block;
    }
  }

  @media (prefers-reduced-motion: reduce) and (width < 760px) {
    .flight__film {
      height: auto;
      aspect-ratio: 4 / 5;
    }

    .flight__poster--rest {
      display: none;
    }

    .flight__poster--rest-tall {
      display: block;
    }
  }
</style>
