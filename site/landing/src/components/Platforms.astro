---
import BatteryFull from "@lucide/astro/icons/battery-full";
import ChartColumn from "@lucide/astro/icons/chart-column";
import ChevronLeft from "@lucide/astro/icons/chevron-left";
import ChevronRight from "@lucide/astro/icons/chevron-right";
import Compass from "@lucide/astro/icons/compass";
import EllipsisVertical from "@lucide/astro/icons/ellipsis-vertical";
import House from "@lucide/astro/icons/house";
import Lock from "@lucide/astro/icons/lock";
import Minus from "@lucide/astro/icons/minus";
import Plus from "@lucide/astro/icons/plus";
import RotateCw from "@lucide/astro/icons/rotate-cw";
import Search from "@lucide/astro/icons/search";
import Signal from "@lucide/astro/icons/signal";
import Square from "@lucide/astro/icons/square";
import User from "@lucide/astro/icons/user";
import Wifi from "@lucide/astro/icons/wifi";
import X from "@lucide/astro/icons/x";
import { devicePlatforms, phoneCards, tabletCards } from "../content/devices";
import BrandIcon from "./BrandIcon.astro";
import Logo from "./Logo.astro";

/**
 * Six native apps, zero lag: a phone, a tablet and a laptop, each running Rondo as its platform draws it. One device
 * at a time turns into another platform (the phone and the tablet between Apple's and Android, the laptop between
 * Windows, Linux, the web and macOS), its mark changing beneath it, and then studies a card, answered the instant
 * it's touched (motion/platforms.ts). The styles draw each platform from the device's data-os; everything is sized
 * in units of the stage's width, so it scales as one picture.
 */
const places = [
  { label: "Home", icon: House },
  { label: "Browse", icon: Search },
  { label: "Discover", icon: Compass },
  { label: "Progress", icon: ChartColumn },
  { label: "Profile", icon: User },
];
const decks = ["Japanese", "Calculus", "Cardiology", "History"];
const ratings = ["Again", "Hard", "Good", "Easy"];
---

<section class="section platforms" id="apps" aria-labelledby="apps-title" data-mood="apps">
  <div class="container platforms__inner">
    <div class="platforms__copy">
      <p class="kicker" data-reveal="fade">
        <span class="kicker__index">04</span>Native everywhere
      </p>
      <h2 id="apps-title" class="heading" data-reveal="words">
        Six native apps. <em>Zero lag.</em>
      </h2>
      <p class="lead" data-reveal="lines">
        Rondo is made for each platform it runs on: iPhone, iPad, Android, Mac, Windows and Linux, and the web too. It
        answers from your device instead of a server, so every tap is instant, even on a plane.
      </p>
    </div>

    <div class="trio" aria-hidden="true" data-trio data-reveal="rise">
      {/* The laptop: one window, in each desktop's own frame, or a browser's. */}
      <div class="dev dev--laptop" data-dev="laptop" data-os={devicePlatforms.laptop[0].os}>
        <div class="dev__float" data-float>
          <div class="laptop">
            <div class="laptop__screen">
              <div class="bar bar--mac" data-chrome="macos">
                <span class="lights">
                  <i></i>
                  <i></i>
                  <i></i>
                </span>
                <span class="bar__title">Rondo</span>
              </div>
              <div class="bar bar--windows" data-chrome="windows">
                <span class="bar__app">
                  <Logo mark /> Rondo
                </span>
                <span class="bar__controls">
                  <Minus />
                  <Square />
                  <X />
                </span>
              </div>
              <div class="bar bar--linux" data-chrome="linux">
                <span class="bar__title">Rondo</span>
                <span class="bar__close">
                  <X />
                </span>
              </div>
              <div class="bar bar--web" data-chrome="web">
                <div class="browser__tabs">
                  <span class="lights">
                    <i></i>
                    <i></i>
                    <i></i>
                  </span>
                  <span class="browser__tab">
                    <Logo mark /> Rondo <X />
                  </span>
                  <Plus class="browser__new" />
                </div>
                <div class="browser__address">
                  <ChevronLeft />
                  <ChevronRight />
                  <RotateCw />
                  <span class="browser__url">
                    <Lock /> rondo.matthewsource.com/app
                  </span>
                </div>
              </div>

              <div class="app">
                <div class="app__side">
                  <ul class="side-places">
                    {places.map(({ label, icon: Icon }, index) => (
                      <li class:list={{ "is-current": index === 0 }}>
                        <Icon />
                        {label}
                      </li>
                    ))}
                  </ul>
                  <p class="side-heading">Decks</p>
                  <ul class="side-decks">
                    {decks.map((deck) => (
                      <li class:list={{ "is-current": deck === "Calculus" }}>{deck}</li>
                    ))}
                  </ul>
                </div>
                <div class="app__main">
                  <p class="deck-head">
                    <b>Calculus</b>
                    <span>12 due</span>
                  </p>
                  <div class="study" data-study>
                    <div class="study__cards">
                      <div class="study__card" data-card data-current>
                        <p class="study__front">
                          <span class="math">
                            <span class="math__int">∫</span>
                            <span class="math__limits">
                              <span>1</span>
                              <span>0</span>
                            </span>
                            <i>x</i>
                            <sup>2</sup>&thinsp;d<i>x</i>
                          </span>
                        </p>
                        <div class="study__answer">
                          <i class="study__rule"></i>
                          <p class="study__back">
                            <span class="math">
                              <span class="frac">
                                <span>1</span>
                                <span>3</span>
                              </span>
                            </span>
                          </p>
                        </div>
                      </div>
                      <div class="study__card" data-card>
                        <p class="study__front">
                          <span class="math">
                            <span class="frac">
                              <span>d</span>
                              <span>
                                d<i>x</i>
                              </span>
                            </span>
                            &thinsp;sin&thinsp;<i>x</i>
                          </span>
                        </p>
                        <div class="study__answer">
                          <i class="study__rule"></i>
                          <p class="study__back">
                            <span class="math">
                              cos&thinsp;<i>x</i>
                            </span>
                          </p>
                        </div>
                      </div>
                      <div class="study__card" data-card>
                        <p class="study__front">
                          <span class="math">
                            <span class="math__lim">
                              lim
                              <small>
                                <i>x</i>→0
                              </small>
                            </span>
                            <span class="frac">
                              <span>
                                sin&thinsp;<i>x</i>
                              </span>
                              <span>
                                <i>x</i>
                              </span>
                            </span>
                          </span>
                        </p>
                        <div class="study__answer">
                          <i class="study__rule"></i>
                          <p class="study__back">
                            <span class="math">1</span>
                          </p>
                        </div>
                      </div>
                    </div>
                    <div class="study__actions">
                      <span class="study__show" data-show>
                        Show answer
                      </span>
                      <span class="study__rates">
                        {ratings.map((rating) => (
                          <span data-rate={rating}>{rating}</span>
                        ))}
                      </span>
                    </div>
                  </div>
                </div>
              </div>

              <svg class="cursor" viewBox="0 0 16 22" data-cursor>
                <path d="M1.5 1.5v16.2l4.3-4.1 2.9 6.6 2.9-1.3-2.9-6.5h5.9z"></path>
              </svg>
            </div>
          </div>
          <div class="laptop__base">
            <i></i>
          </div>
        </div>
        <div class="badge">
          {devicePlatforms.laptop.map((platform) => (
            <span class="badge__item" data-chrome={platform.os}>
              <BrandIcon name={platform.brand} />
              {platform.name}
            </span>
          ))}
        </div>
      </div>

      {/* The tablet: a sidebar on iPadOS, a navigation rail on Android. */}
      <div class="dev dev--tablet" data-dev="tablet" data-os={devicePlatforms.tablet[0].os}>
        <div class="dev__float" data-float>
          <div class="tablet">
            <div class="tablet__screen">
              <div class="status status--tablet">
                <span>9:41&ensp;Thu 8 Oct</span>
                <span class="status__icons">
                  <Wifi />
                  <BatteryFull />
                </span>
              </div>
              <div class="tablet__side" data-chrome="ipados">
                <p class="tablet__brand">
                  <Logo mark /> Rondo
                </p>
                <ul class="side-places">
                  {places.slice(0, 4).map(({ label, icon: Icon }, index) => (
                    <li class:list={{ "is-current": index === 0 }}>
                      <Icon />
                      {label}
                    </li>
                  ))}
                </ul>
                <p class="side-heading">Decks</p>
                <ul class="side-decks">
                  {decks.map((deck) => (
                    <li class:list={{ "is-current": deck === "Cardiology" }}>{deck}</li>
                  ))}
                </ul>
              </div>
              <div class="tablet__rail" data-chrome="android">
                {places.map(({ icon: Icon }, index) => (
                  <span class:list={{ "is-current": index === 0 }}>
                    <Icon />
                  </span>
                ))}
              </div>
              <div class="tablet__main">
                <p class="deck-head">
                  <b>Cardiology</b>
                  <span>8 due</span>
                </p>
                <div class="study study--cloze" data-study>
                  <div class="study__cards">
                    {tabletCards.map((card, index) => (
                      <div class="study__card" data-card data-current={index === 0 ? "" : undefined}>
                        <p class="study__front">
                          {card.before}{" "}
                          <span class="cloze">
                            <span class="cloze__blank">[…]</span>
                            <span class="cloze__word">{card.answer}</span>
                          </span>{" "}
                          {card.after}
                        </p>
                      </div>
                    ))}
                  </div>
                  <div class="study__actions">
                    <span class="study__show" data-show>
                      Show answer
                    </span>
                    <span class="study__rates">
                      {ratings.map((rating) => (
                        <span data-rate={rating}>{rating}</span>
                      ))}
                    </span>
                  </div>
                </div>
              </div>
              <i class="touch" data-touch></i>
            </div>
          </div>
        </div>
        <div class="badge">
          {devicePlatforms.tablet.map((platform) => (
            <span class="badge__item" data-chrome={platform.os}>
              <BrandIcon name={platform.brand} />
              {platform.name}
            </span>
          ))}
        </div>
      </div>

      {/* The phone: the Dynamic Island and a tab bar on iOS, a camera hole and a navigation bar on Android. */}
      <div class="dev dev--phone" data-dev="phone" data-os={devicePlatforms.phone[0].os}>
        <div class="dev__float" data-float>
          <div class="phone">
            <div class="phone__screen">
              <i class="phone__island"></i>
              <div class="status status--phone">
                <span>9:41</span>
                <span class="status__icons">
                  <Signal />
                  <Wifi />
                  <BatteryFull />
                </span>
              </div>
              <div class="phone__heads">
                <p class="phone__head phone__head--ios" data-chrome="ios">
                  <b>Japanese</b>
                  <span>24 due</span>
                </p>
                <p class="phone__head phone__head--android" data-chrome="android">
                  <b>Japanese</b>
                  <span>24 due</span>
                  <EllipsisVertical />
                </p>
              </div>
              <div class="study" data-study>
                <div class="study__cards">
                  {phoneCards.map((card, index) => (
                    <div class="study__card" data-card data-current={index === 0 ? "" : undefined}>
                      <p class="study__front" lang="ja">
                        <ruby>
                          {card.word}
                          <rt>{card.reading}</rt>
                        </ruby>
                      </p>
                      <div class="study__answer">
                        <i class="study__rule" />
                        <p class="study__back">{card.meaning}</p>
                      </div>
                    </div>
                  ))}
                </div>
                <div class="study__actions">
                  <span class="study__show" data-show>
                    Show answer
                  </span>
                  <span class="study__rates">
                    {ratings.map((rating) => (
                      <span data-rate={rating}>{rating}</span>
                    ))}
                  </span>
                </div>
              </div>
              <div class="phone__tabs">
                <div class="tabs tabs--ios" data-chrome="ios">
                  {places.map(({ label, icon: Icon }, index) => (
                    <span class:list={{ "is-current": index === 0 }}>
                      <Icon />
                      {label}
                    </span>
                  ))}
                </div>
                <div class="tabs tabs--android" data-chrome="android">
                  {places.map(({ label, icon: Icon }, index) => (
                    <span class:list={{ "is-current": index === 0 }}>
                      <i>
                        <Icon />
                      </i>
                      {label}
                    </span>
                  ))}
                </div>
              </div>
              <i class="touch" data-touch></i>
            </div>
          </div>
        </div>
        <div class="badge">
          {devicePlatforms.phone.map((platform) => (
            <span class="badge__item" data-chrome={platform.os}>
              <BrandIcon name={platform.brand} />
              {platform.name}
            </span>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .platforms__inner {
    display: grid;
    justify-items: center;
    gap: clamp(48px, 8vh, 88px);
  }

  .platforms__copy {
    display: grid;
    justify-items: center;
    gap: clamp(20px, 3vh, 32px);
    text-align: center;
  }

  .platforms__copy .lead {
    max-width: 36em;
  }

  /* The stage: everything inside is measured in its width (cqw), so the picture scales as one. */
  .trio {
    position: relative;
    width: min(100%, 1180px);
    aspect-ratio: 100 / 54;
    container-type: inline-size;
    font-size: 1cqw;
    line-height: 1.25;
    color: var(--ink);
    user-select: none;
  }

  .trio :global(svg) {
    display: block;
    flex: none;
  }

  .dev {
    position: absolute;
    display: grid;
    justify-items: center;
  }

  .dev--laptop {
    left: 17cqw;
    top: 1cqw;
    width: 66cqw;
    z-index: 1;
  }

  .dev--tablet {
    left: 3.5cqw;
    top: 14cqw;
    width: 25cqw;
    z-index: 2;
  }

  .dev--phone {
    left: 76cqw;
    top: 17.5cqw;
    width: 14.5cqw;
    z-index: 3;
  }

  .dev__float {
    width: 100%;
    will-change: transform;
  }

  /* Frames: light aluminium around a white screen. */
  .laptop,
  .tablet,
  .phone {
    position: relative;
    background: linear-gradient(150deg, #fdfdfe 0%, #eceef2 55%, #e3e6eb 100%);
    box-shadow:
      0 0 0 0.08cqw rgb(11 11 13 / 10%),
      0 0.08cqw 0 rgb(255 255 255 / 90%) inset,
      0 2.4cqw 4.4cqw -2cqw rgb(30 40 80 / 34%),
      0 0.6cqw 1.4cqw -0.6cqw rgb(30 40 80 / 14%);
  }

  .laptop__screen,
  .tablet__screen,
  .phone__screen {
    position: relative;
    overflow: hidden;
    background: #fff;
    box-shadow: 0 0 0 0.08cqw rgb(11 11 13 / 12%);
  }

  .laptop {
    width: 62cqw;
    padding: 0.75cqw;
    border-radius: 1.6cqw 1.6cqw 0.5cqw 0.5cqw;
  }

  .laptop__screen {
    aspect-ratio: 16 / 10;
    border-radius: 0.9cqw 0.9cqw 0.2cqw 0.2cqw;
  }

  .laptop__base {
    position: relative;
    width: 100%;
    height: 1.5cqw;
    border-radius: 0.15cqw 0.15cqw 1.6cqw 1.6cqw;
    background: linear-gradient(180deg, #f7f8fa 0%, #dfe2e8 70%, #cfd3da 100%);
    box-shadow:
      0 0 0 0.08cqw rgb(11 11 13 / 9%),
      0 1.6cqw 2.6cqw -1.4cqw rgb(30 40 80 / 40%);
  }

  .laptop__base i {
    position: absolute;
    left: 50%;
    top: 0;
    width: 9cqw;
    height: 0.55cqw;
    border-radius: 0 0 0.6cqw 0.6cqw;
    background: linear-gradient(180deg, #d6dae0, #e9ecf0);
    translate: -50% 0;
  }

  .tablet {
    width: 100%;
    padding: 0.9cqw;
    border-radius: 2.2cqw;
  }

  .tablet__screen {
    aspect-ratio: 3 / 4.15;
    border-radius: 1.35cqw;
  }

  .phone {
    width: 100%;
    padding: 0.55cqw;
    border-radius: 2.6cqw;
  }

  .phone__screen {
    aspect-ratio: 9 / 19.6;
    border-radius: 2.1cqw;
  }

  /* Each platform's parts: shown on that platform, cross-fading through a blur as the device turns. */
  .dev :global([data-chrome]) {
    opacity: 0;
    visibility: hidden;
    filter: blur(0.35cqw);
    transition:
      opacity 0.45s var(--ease-out),
      filter 0.45s var(--ease-out),
      visibility 0s linear 0.45s;
  }

  .dev[data-os="ios"] :global([data-chrome~="ios"]),
  .dev[data-os="ipados"] :global([data-chrome~="ipados"]),
  .dev[data-os="android"] :global([data-chrome~="android"]),
  .dev[data-os="macos"] :global([data-chrome~="macos"]),
  .dev[data-os="windows"] :global([data-chrome~="windows"]),
  .dev[data-os="linux"] :global([data-chrome~="linux"]),
  .dev[data-os="web"] :global([data-chrome~="web"]) {
    opacity: 1;
    visibility: visible;
    filter: none;
    transition:
      opacity 0.7s var(--ease-out) 0.2s,
      filter 0.7s var(--ease-out) 0.2s,
      visibility 0s;
  }

  /* The platform's mark under each device. */
  .badge {
    display: grid;
    margin-top: 2.2cqw;
    font-size: max(10px, 1.05cqw);
  }

  .dev--laptop .badge {
    margin-top: 2.6cqw;
  }

  .badge__item {
    grid-area: 1 / 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.55em;
    padding: 0.5em 1em 0.5em 0.85em;
    border-radius: 999px;
    background: rgb(255 255 255 / 72%);
    box-shadow:
      0 0 0 1px var(--line) inset,
      0 1px 0 var(--glass-edge) inset,
      var(--shadow-1);
    font-weight: 500;
    white-space: nowrap;
    color: var(--ink);
  }

  .badge__item :global(.brand-icon) {
    width: 1.15em;
    height: 1.15em;
  }

  /* Status bars. */
  .status {
    position: absolute;
    inset: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    z-index: 3;
  }

  .status__icons {
    display: flex;
    align-items: center;
    gap: 0.25cqw;
  }

  .status--phone {
    height: 2.3cqw;
    padding: 0 1.3cqw 0 1.6cqw;
    font-size: 0.68cqw;
  }

  .status--phone :global(svg) {
    width: 0.78cqw;
    height: 0.78cqw;
    stroke-width: 2.6;
  }

  .status--tablet {
    height: 1.7cqw;
    padding: 0 1.1cqw;
    font-size: 0.58cqw;
  }

  .status--tablet :global(svg) {
    width: 0.7cqw;
    height: 0.7cqw;
    stroke-width: 2.4;
  }

  /* The Dynamic Island on iOS; on Android it shrinks into a camera hole. */
  .phone__island {
    position: absolute;
    left: 50%;
    top: 0.55cqw;
    z-index: 4;
    width: 3.9cqw;
    height: 1.15cqw;
    border-radius: 0.6cqw;
    background: var(--ink);
    translate: -50% 0;
    transition:
      width 0.9s var(--ease-spring),
      height 0.9s var(--ease-spring),
      top 0.9s var(--ease-spring),
      border-radius 0.9s var(--ease-spring);
  }

  .dev--phone[data-os="android"] .phone__island {
    top: 0.7cqw;
    width: 0.8cqw;
    height: 0.8cqw;
    border-radius: 50%;
  }

  .phone__screen {
    display: grid;
    grid-template-rows: 2.3cqw auto 1fr auto;
  }

  .phone__heads {
    grid-row: 2;
    display: grid;
    padding: 0.6cqw 1.1cqw 0;
  }

  .phone__head {
    grid-area: 1 / 1;
    display: flex;
    align-items: baseline;
    gap: 0.5cqw;
  }

  .phone__head span {
    font-size: 0.62cqw;
    color: var(--ink-3);
  }

  .phone__head--ios {
    flex-direction: column;
    gap: 0.1cqw;
  }

  .phone__head--ios b {
    font-size: 1.45cqw;
    font-weight: 650;
    letter-spacing: -0.03em;
  }

  .phone__head--android {
    align-items: center;
    padding-top: 0.3cqw;
  }

  .phone__head--android b {
    font-size: 1.05cqw;
    font-weight: 500;
  }

  .phone__head--android :global(svg) {
    width: 0.9cqw;
    height: 0.9cqw;
    margin-left: auto;
    color: var(--ink-2);
  }

  .phone__tabs {
    grid-row: 4;
    display: grid;
  }

  .tabs {
    grid-area: 1 / 1;
    display: flex;
    justify-content: space-around;
  }

  .tabs > span {
    display: grid;
    justify-items: center;
    gap: 0.2cqw;
    font-size: 0.45cqw;
    color: var(--ink-3);
  }

  .tabs > span.is-current {
    color: #2f6fed;
  }

  .tabs :global(svg) {
    width: 0.95cqw;
    height: 0.95cqw;
    stroke-width: 2;
  }

  .tabs--ios {
    padding: 0.5cqw 0.5cqw 1.1cqw;
    background: rgb(250 250 252 / 92%);
    box-shadow: 0 -0.06cqw 0 rgb(11 11 13 / 8%);
  }

  .tabs--android {
    padding: 0.55cqw 0.4cqw 1cqw;
    background: #f2f4fa;
  }

  .tabs--android > span.is-current {
    color: var(--ink);
  }

  .tabs--android i {
    display: grid;
    place-items: center;
    width: 2cqw;
    height: 1.15cqw;
    border-radius: 999px;
  }

  .tabs--android .is-current i {
    background: #d9e2ff;
  }

  /* The tablet: a sidebar on iPadOS, a narrow rail on Android, the study beside either. */
  .tablet__side,
  .tablet__rail {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    padding-top: 2.2cqw;
    background: #f4f5f8;
    box-shadow: -0.06cqw 0 0 rgb(11 11 13 / 7%) inset;
  }

  .tablet__side {
    width: 7.6cqw;
    padding-inline: 0.55cqw;
