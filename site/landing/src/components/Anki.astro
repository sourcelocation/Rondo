---
import { features } from "../content/features";
import { area, curve, marks, plot, recall, reviews } from "../content/history";

/**
 * Coming from Anki. One card's memory runs across the whole screen, from beyond its left edge: recall falls and is
 * refreshed at every review, the gaps growing, and halfway over it passes from Anki into Rondo without a break. The
 * scroll draws it (motion/history.ts); drawn here as it ends, so it reads without the motion. Under it, everything
 * else that came along, as one sentence.
 */
const { width, height, top, target } = plot;
// The reviews and gaps on the screen: the card's first day runs in from beyond its edge.
const done = reviews.filter((review) => review.x > 0 && review.x <= marks.now);
const ahead = reviews.find((review) => review.x > marks.now);
const named = reviews.filter((review) => review.labelX > 0);
/** A place on the plot, as the share of its width and height that CSS positions things by. */
const at = (x: number, y: number = target) => `--x: ${(x / width).toFixed(4)}; --y: ${(y / height).toFixed(4)}`;
---

<section class="section anki" id="anki" aria-labelledby="anki-title" data-mood="anki">
  <div class="container anki__head">
    <h2 id="anki-title" class="heading" data-reveal="words">
      Your Anki,<br /> <em>moved in.</em>
    </h2>
    <p class="lead" data-reveal="lines">
      Import your Anki decks with every review you’ve ever done. Each card carries on with its schedule exactly where
      Anki left it.
    </p>
  </div>

  <figure class="memory" aria-hidden="true" data-memory>
    <i class="memory__wash" style={at(marks.seam)}></i>
    <ol class="memory__gaps">
      {named.map((review) => (
        <li style={at(review.labelX)} data-memory-gap={review.x}>
          {review.label}
        </li>
      ))}
    </ol>
    <div class="memory__plot" data-memory-plot>
      <svg class="memory__svg" viewBox={`0 0 ${width} ${height}`} preserveAspectRatio="none">
        <defs>
          <clipPath id="memory-drawn">
            <rect x={marks.learned} y="-10" width={marks.now - marks.learned} height={height + 20} data-memory-drawn
            ></rect>
          </clipPath>
          <linearGradient id="memory-old" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#0b0b0d" stop-opacity="0.045"></stop>
            <stop offset="1" stop-color="#0b0b0d" stop-opacity="0"></stop>
          </linearGradient>
          <linearGradient id="memory-new" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#8fb4ff" stop-opacity="0.42"></stop>
            <stop offset="0.6" stop-color="#cfbfff" stop-opacity="0.16"></stop>
            <stop offset="1" stop-color="#cfbfff" stop-opacity="0"></stop>
          </linearGradient>
        </defs>

        <line class="memory__rule" x1="0" x2={width} y1={top} y2={top}></line>
        <line class="memory__rule memory__rule--target" x1="0" x2={width} y1={target} y2={target}></line>

        <g clip-path="url(#memory-drawn)">
          <path class="memory__area memory__area--old" d={area(marks.learned, marks.seam)}></path>
          <path class="memory__area memory__area--new" d={area(marks.seam, marks.now)}></path>
          <path class="memory__line memory__line--old" d={curve(marks.learned, marks.seam)}></path>
          <path class="memory__line" d={curve(marks.seam, marks.now)}></path>
        </g>
        {/* Short of the next review, which hasn't happened: recall only falls toward it. */}
        <path class="memory__ahead" d={curve(marks.now, marks.next - 1)} data-memory-ahead></path>
      </svg>

      <div class="memory__seam" style={at(marks.seam, recall(marks.seam))}>
        <i class="memory__seam-line"></i>
        <i class="memory__ripple"></i>
        <i class="memory__ripple"></i>
        <span class="memory__era memory__era--old">Anki</span>
        <span class="memory__era memory__era--new">Rondo</span>
      </div>

      {done.map((review) => (
        <i
          class:list={["memory__review", { "memory__review--old": review.x < marks.seam }]}
          style={at(review.x)}
          data-memory-review={review.x}
        />
      ))}
      {ahead && <i class="memory__review memory__review--next" style={at(ahead.x)} data-memory-next />}

      <div class="memory__probe" data-memory-probe>
        <i class="memory__probe-line"></i>
        <i class="memory__probe-dot"></i>
        <span class="memory__probe-value" data-memory-probe-value></span>
      </div>

      <i class="memory__head" style={at(marks.now, recall(marks.now))} data-memory-head></i>
    </div>

  </figure>

  <div class="container">
    <p class="carried" data-carried>
      <em>Nothing left behind:</em>{" "}
      {features.map((feature, index) => (
        <span data-carried-item>
          {feature}
          {index < features.length - 1 ? ", " : "."}
        </span>
      ))}
    </p>
  </div>
</section>

<script>
  import { CarriedScene, MemoryScene } from "../motion/history";
  import { scene } from "../motion/scenes";

  scene("[data-memory]", (root, stage) => new MemoryScene(root, stage));
  scene("[data-carried]", (root, stage) => new CarriedScene(root, stage.reduced));
</script>

<style>
  /* The words: the heading on the left, what it means on the right, sharing a baseline. */
  .anki__head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 26rem);
    align-items: end;
    gap: var(--stack) clamp(32px, 6vw, 120px);
  }

  .anki__head .lead {
    padding-bottom: 0.35em;
  }

  /* The card's memory, from one edge of the screen to the other. */
  .memory {
    --plot: clamp(150px, 3rem + 13vw, 280px);
    /* Room under the plot for the seam's words. */
    --below: clamp(52px, 1.5rem + 3.5vw, 96px);
    /* How far the seam reaches over the plot: through the gaps' names. */
    --over: 48px;
    --old: rgb(11 11 13 / 30%);
    --seam: #6f8fff;
    position: relative;
    margin: clamp(80px, 3rem + 7vw, 168px) 0 0;
    padding-bottom: var(--below);
  }

  .memory__plot {
    position: relative;
    height: var(--plot);
  }

  /* Rondo's side, lit: a wash of the page's light from the seam to the right edge, over and under the plot. */
  .memory__wash {
    position: absolute;
    left: calc(var(--x) * 100%);
    right: 0;
    top: -32px;
    bottom: -24px;
    background:
      linear-gradient(90deg, rgb(111 143 255 / 30%), rgb(143 180 255 / 16%) 22%, rgb(207 191 255 / 8%) 60%, transparent),
      linear-gradient(90deg, rgb(111 143 255 / 35%), transparent 4%);
    -webkit-mask-image: linear-gradient(transparent, #000 22%, #000 78%, transparent);
    mask-image: linear-gradient(transparent, #000 22%, #000 78%, transparent);
    transition:
      clip-path 1.8s var(--ease-out),
      opacity 1.2s var(--ease-out);
  }

  .memory__svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .memory__rule {
    stroke: var(--line);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .memory__rule--target {
    stroke: var(--line-2);
    stroke-dasharray: 2 6;
  }

  .memory__area--old {
    fill: url(#memory-old);
  }

  .memory__area--new {
    fill: url(#memory-new);
  }

  .memory__line,
  .memory__ahead {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.5;
    stroke-linejoin: round;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }

  .memory__line--old {
    stroke: var(--old);
    transition: stroke 1.4s var(--ease-out);
  }

  /* The year ahead, still to come: a row of dots that drifts on toward the next review. */
  .memory__ahead {
    stroke: rgb(11 11 13 / 40%);
    stroke-width: 2;
    stroke-dasharray: 0 7;
    transition: opacity 0.8s var(--ease-out);
  }

  /* What sits on the plot, placed by its --x and --y. */
  .memory__review,
  .memory__head,
  .memory__seam,
  .memory__probe {
    position: absolute;
    left: calc(var(--x) * 100%);
    top: calc(var(--y) * 100%);
  }

  .memory__review {
    width: 11px;
    height: 11px;
    margin: -5.5px 0 0 -5.5px;
    border-radius: 50%;
    background: var(--paper);
    box-shadow: 0 0 0 1.5px var(--ink) inset;
    transition: scale 0.7s var(--ease-spring);
  }

  .memory__review--old {
    box-shadow: 0 0 0 1.5px var(--old) inset;
    transition:
      scale 0.7s var(--ease-spring),
      box-shadow 1.4s var(--ease-out);
  }

  .memory__review--next {
    background: none;
    box-shadow: none;
    outline: 1.5px dashed rgb(11 11 13 / 45%);
    outline-offset: -1.5px;
    transition:
      scale 0.9s var(--ease-spring) 0.5s,
      opacity 0.6s var(--ease-out) 0.5s;
  }

  /* Where the card came over: a line through the whole plot, Anki on one side of it and Rondo on the other. */
  .memory__seam {
    top: 0;
    bottom: 0;
    width: 0;
  }

  .memory__seam-line {
    position: absolute;
    left: -0.75px;
    top: calc(-1 * var(--over));
    bottom: calc(-1 * var(--below) - 16px);
    width: 1.5px;
    background: linear-gradient(transparent, var(--seam) 14%, var(--seam) 78%, transparent);
    box-shadow: 0 0 12px 1px rgb(111 143 255 / 45%);
    transform-origin: 50% calc(var(--y) * var(--plot) + var(--over));
    transition: scale 1.3s var(--ease-out);
  }

  .memory__ripple {
    position: absolute;
    left: -60px;
    top: calc(var(--y) * var(--plot) - 60px);
    width: 120px;
    height: 120px;
    border-radius: 50%;
    box-shadow: 0 0 0 1.5px var(--seam) inset;
    opacity: 0;
  }

  /* The two places, either side of the line, as big as a heading's smaller words. */
  .memory__era {
    position: absolute;
    top: calc(100% + var(--below) * 0.32);
    font-size: var(--size-h3);
    font-weight: 380;
    letter-spacing: -0.035em;
    line-height: 1;
    white-space: nowrap;
    transition:
      translate 1.3s var(--ease-out),
      opacity 1.3s var(--ease-out);
  }

  .memory__era--old {
    right: 20px;
    color: var(--ink-3);
  }

  .memory__era--new {
    left: 20px;
    font-family: var(--serif);
    font-weight: 340;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  /* Now: the point the scroll moves along the curve, breathing where it rests. */
  .memory__head {
    width: 11px;
    height: 11px;
    margin: -5.5px 0 0 -5.5px;
    border-radius: 50%;
    background: var(--ink);
  }

  /* Moving, it's placed by its translation alone, which takes no layout. */
  .memory.is-moving .memory__head {
    left: 0;
    top: 0;
  }

  .memory__head::before {
    content: "";
    position: absolute;
    inset: -14px;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(111 143 255 / 55%), rgb(143 180 255 / 0%));
  }

  .memory.is-moving .memory__head::before {
    animation: memory-breathe 3.2s var(--ease-in-out) infinite alternate;
  }

  @keyframes memory-breathe {
    from {
      scale: 0.7;
      opacity: 0.6;
    }
    to {
      scale: 1.25;
      opacity: 1;
    }
  }

  /* Recall wherever a mouse points on what's been drawn. */
  .memory__probe {
    top: 0;
    bottom: 0;
    width: 0;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.4s var(--ease-out);
  }

  .memory__probe.is-on {
    opacity: 1;
  }

  .memory__probe-line {
    position: absolute;
    left: -0.5px;
    top: 0;
    bottom: 0;
    width: 1px;
    background: linear-gradient(transparent, var(--line-2) 20%, var(--line-2) 80%, transparent);
  }

  .memory__probe-dot {
    position: absolute;
    left: -3.5px;
    top: calc(var(--y) * 100% - 3.5px);
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--ink);
  }

  .memory__probe-value {
    position: absolute;
    left: 12px;
    top: calc(var(--y) * 100% - 24px);
    font: 500 11px / 1 var(--mono);
    font-variant-numeric: tabular-nums;
    color: var(--ink);
  }

  /* How long each gap was, over it, named as the point reaches its end. */
  .memory__gaps {
    position: relative;
    height: 1em;
    margin-bottom: 22px;
    font: 450 var(--size-micro) / 1 var(--mono);
    color: var(--ink-3);
  }

  .memory__gaps li {
    position: absolute;
    left: calc(var(--x) * 100%);
    translate: -50% 0;
    transition:
      opacity 0.7s var(--ease-out),
      translate 0.7s var(--ease-out);
  }

  /*
   * With the motion, the scroll draws the curve: what it hasn't reached waits out of sight. What it has reached is
   * marked .is-on (motion/history.ts).
   */
  .memory.is-moving .memory__review:not(.is-on) {
    scale: 0;
  }

  .memory.is-moving .memory__review--next:not(.is-on) {
    opacity: 0;
    transition-delay: 0s;
  }

  .memory.is-moving .memory__ahead:not(.is-on) {
    opacity: 0;
  }

  .memory.is-moving .memory__ahead.is-on {
    animation: memory-drift 0.9s linear infinite;
  }

  @keyframes memory-drift {
    to {
      stroke-dashoffset: -7;
    }
  }

  .memory.is-moving .memory__gaps li:not(.is-on) {
    opacity: 0;
    translate: -50% -6px;
  }

  /*
   * Until the point has crossed into Rondo (.is-moved), there's no seam: the curve so far is drawn in ink, as the
   * present, and Rondo's side is unlit. Crossing, the line opens up out of the curve, the two names part from it, the
   * light sweeps out over Rondo's side, and Anki's curve greys into the past.
   */
  .memory.is-moving:not(.is-moved) .memory__seam-line {
    scale: 1 0;
  }

  .memory.is-moving:not(.is-moved) .memory__era {
    opacity: 0;
  }

  .memory.is-moving:not(.is-moved) .memory__era--old {
    translate: 40px 0;
  }

  .memory.is-moving:not(.is-moved) .memory__era--new {
    translate: -40px 0;
  }

  .memory.is-moving:not(.is-moved) .memory__wash {
    clip-path: inset(0 100% 0 0);
    opacity: 0;
  }

  .memory.is-moving:not(.is-moved) .memory__line--old {
    stroke: var(--ink);
  }

  .memory.is-moving:not(.is-moved) .memory__review--old {
    box-shadow: 0 0 0 1.5px var(--ink) inset;
  }

  .memory.is-moved .memory__ripple {
    animation: memory-ripple 1.8s var(--ease-out) both;
  }

  .memory.is-moved .memory__ripple + .memory__ripple {
    animation-delay: 0.22s;
  }

  @keyframes memory-ripple {
    from {
      scale: 0.05;
      opacity: 1;
    }
    to {
      scale: 1;
      opacity: 0;
    }
  }

  /* Everything that came along, as one sentence the scroll reads out (motion/history.ts). */
  .carried {
    max-width: 24em;
    margin-top: clamp(96px, 4rem + 7vw, 200px);
    margin-left: auto;
    font-size: clamp(1.625rem, 1rem + 2.2vw, 3.25rem);
    font-weight: 380;
    line-height: 1.12;
    letter-spacing: -0.04em;
    text-wrap: pretty;
  }

  /* Until the scroll reads it out, the sentence waits dimmed (motion/history.ts); without the motion it's all lit. */
  :global(html[data-motion]:not([data-motion="off"])) .carried span {
    opacity: 0.14;
  }

  .carried em {
    font-family: var(--serif);
    font-style: normal;
    font-weight: 340;
    letter-spacing: -0.025em;
  }

  @media (width < 960px) {
    .anki__head {
      grid-template-columns: minmax(0, 1fr);
    }

    .carried {
      margin-left: 0;
    }
  }

  /* On a phone the first gaps are too narrow to name. */
  @media (width < 640px) {
    .memory__gaps li:nth-child(-n + 3) {
      display: none;
    }
  }
</style>
