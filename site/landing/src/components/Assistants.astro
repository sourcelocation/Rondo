---
import ArrowUpRight from "@lucide/astro/icons/arrow-up-right";
import { requests, resting } from "../content/assistants";
import { links } from "../content/links";

/**
 * AI. The headline is the request: "Make your cards", then an empty line where a caret blinks, and under it a row of
 * places for the cards that come of it, each a window onto one swelling wireframe surface
 * (motion/assistant/field.ts). What someone asks for is typed out ("…from my biology notes."), stirring it; a light
 * reads through the words and it swells; then a shockwave crosses the row, the surface heaving into a ridge whose lines
 * flare as it passes, and in its wake the water stills and each card is uncovered. Under the row, the assistant that
 * made them. Then the words are selected and gone, the cards go, and the next request is typed.
 * motion/assistant.ts tells it; drawn here as it rests ("…with AI.", the first cards made), so it reads without the
 * motion.
 */
// Every ending the headline takes, unseen in its place, so it keeps the room of the longest as they're typed.
const endings = [resting, ...requests.map((request) => request.words)];
// The row's places, each holding every request's card for it: seven, the requests'
// five cards going round, so the row reaches past both edges of the widest screen all the while it's carried along;
// narrower, it shows five of them (the style below).
const size = requests[0]?.cards.length ?? 0;
const places = Array.from({ length: 7 }, (_, index) => ({
  cards: requests.flatMap((request) => request.cards[index % size] ?? []),
}));
---

<section class="section ai" id="ai" aria-labelledby="ai-title" data-mood="ai" data-ai>
  <div class="container">
    <div class="ai__head">
      <h2 id="ai-title" class="heading ai__title">
        <span data-reveal="words">Make your cards</span>
        <em class="typed" data-reveal="fade">
          <span class="visually-hidden">{resting}</span>
          <span class="typed__cell" aria-hidden="true">
            {endings.map((ending) => <span class="typed__room">{ending}</span>)}
            <span class="typed__line"><span class="typed__select" data-typed-select><span class="typed__text" data-typed>{resting}</span></span><i class="typed__caret"></i></span>
          </span>
        </em>
      </h2>

      <div class="ai__words">
        <p class="lead" data-reveal="lines">
          Ask AI like Claude, ChatGPT, Gemini to make your cards, and make the ones you have better.
        </p>
        <a class="link ai__link" href={`${links.docs}agents`} data-reveal="fade">
          Connect an assistant <ArrowUpRight aria-hidden="true" />
        </a>
      </div>
    </div>

    <div class="row" aria-hidden="true" data-row>
      <ol class="row__places">
        {places.map(({ cards }) => (
          <li class="card" data-place>
            <canvas class="card__field" data-field></canvas>
            <div class="card__made" data-made>
              {cards.map((card) => (
                <div class="card__face" data-face>
                  <span class="card__deck">{card.deck}</span>
                  <span class="card__front" lang={card.lang}>
                    {card.front}
                  </span>
                  <span class="card__back" lang={card.lang}>
                    {card.back}
                    {card.detail && <small lang="en">{card.detail}</small>}
                  </span>
                </div>
              ))}
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<script>
  import { Assistant } from "../motion/assistant";
  import { scene } from "../motion/scenes";

  scene("[data-ai]", (root, stage) => new Assistant(root, stage));
</script>

<style>
  /* The headline on the left, what it means beside it, sharing its foot. */
  .ai__head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 21rem);
    align-items: end;
    gap: var(--stack) clamp(32px, 4vw, 64px);
  }

  /* The headline: its start, and the ending that's typed, on a line of its own. */
  .ai__title {
    display: grid;
    justify-items: start;
  }

  /*
   * The ending as it's typed: one cell holding every ending unseen, so the headline keeps the room of the longest,
   * and the line being typed over them. It wraps as it goes, not balanced, so the words don't hop about as they come.
   */
  .typed {
    display: grid;
    width: 100%;
    text-wrap: wrap;
  }

  .typed__cell {
    display: grid;
  }

  .typed__cell > * {
    grid-area: 1 / 1;
  }

  .typed__room {
    visibility: hidden;
  }

  /* Room for the caret too. */
  .typed__room::after {
    content: "";
    display: inline-block;
    width: 0.12em;
  }

  /* Selected, as an editor shows it: the page's own selection colour, swept across by the motion. */
  .typed__select {
    background: linear-gradient(rgb(169 202 255 / 55%), rgb(169 202 255 / 55%)) 0 0 / 0% 100% no-repeat;
  }

  /* Read: a light passes through the words, once, as the assistant takes them in. */
  .typed__text.is-reading {
    color: transparent;
    background: linear-gradient(
        100deg,
        var(--ink) 0 38%,
        #6f8fff 45%,
        #b8a6ff 50%,
        #6f8fff 55%,
        var(--ink) 62% 100%
      )
      100% 0 / 320% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    animation: reading 1s var(--ease-in-out) forwards;
  }

  @keyframes reading {
    to {
      background-position: 0% 0;
    }
  }

  /* The caret: steady while typing, blinking while it waits, before the words and after them; gone at rest. */
  .typed__caret {
    display: inline-block;
    width: max(2px, 0.045em);
    height: 0.8em;
    margin-left: 0.06em;
    vertical-align: -0.04em;
    border-radius: 2px;
    background: var(--ink);
    opacity: 0;
  }

  .typed.is-typing .typed__caret {
    opacity: 1;
  }

  .typed.is-waiting .typed__caret {
    animation: caret 1s steps(1) infinite;
  }

  @keyframes caret {
    0% {
      opacity: 1;
    }

    50% {
      opacity: 0;
    }
  }

  /*
   * The row: a place for each card, side by side, each nearly half the container wide, so the middle one is centred
   * and the row runs off both edges of the screen. As it scrolls in, the cards slide into their places (the motion).
   * A shockwave crosses it (motion/assistant/field.ts), and each card shows itself as it reaches it; without the
   * motion, the first cards are made.
   */
  .row {
    --n: 7;
    --gap: clamp(14px, 0.4rem + 1.3vw, 36px);
    position: relative;
    margin-top: clamp(64px, 2rem + 5vw, 128px);
    container-type: inline-size;
  }

  .row__places {
    /* A card's width, and the room it takes in the row with the gap after it, as its words are sized and uncovered by. */
    --w: calc((100cqw - 4 * var(--gap)) * 0.45);
    --place: calc(var(--w) + var(--gap));
    display: grid;
    grid-template-columns: repeat(var(--n), var(--w));
    gap: var(--gap);
    width: calc(var(--n) * var(--place) - var(--gap));
    margin-left: calc((100cqw - var(--n) * var(--place) + var(--gap)) / 2);
  }

  /*
   * A card's place: pale glass and its outline, there before it's made, over the surface it's made from.
   */
  .card {
    --r: calc(var(--w) * 0.055);
    position: relative;
    aspect-ratio: 25 / 16;
    border-radius: var(--r);
    background: rgb(255 255 255 / 50%);
    box-shadow: 0 0 0 1px var(--line-2) inset;
    transition: translate 0.8s var(--ease-spring);
    will-change: transform;
  }

  .card__field {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border-radius: var(--r);
    opacity: 0;
    transition: opacity 1.6s var(--ease-out);
  }

  :global(.row.is-fielded) .card__field {
    opacity: 1;
  }

  /* A made card lifts off its place toward a mouse. */
  @media (hover: hover) and (pointer: fine) {
    .card:hover {
      translate: 0 calc(var(--w) * -0.02);
    }
  }

  /*
   * What's made in a place: the request's card, over the shadow it casts. The motion shows it as the shockwave reaches
   * it, and takes it away.
   */
  .card__made {
    position: absolute;
    inset: 0;
  }

  .card__made::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: var(--r);
    box-shadow: var(--shadow-2);
  }

  /*
   * A card as the rest of the page draws one: its deck, its front, and its answer in the serif.
   */
  .card__face {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-rows: auto 1fr auto;
    padding: calc(var(--w) * 0.06) calc(var(--w) * 0.07) calc(var(--w) * 0.065);
    border-radius: var(--r);
    background: linear-gradient(170deg, #fff 35%, #f7f8fa);
    box-shadow:
      0 1px 0 #fff inset,
      0 0 0 1px rgb(11 11 13 / 6%) inset;
  }

  .card__face + .card__face {
    visibility: hidden;
  }

  :global(.ai.is-live) .card__face {
    visibility: visible;
  }

  .card__deck {
    justify-self: start;
    font-size: max(10px, calc(var(--w) * 0.048));
    font-weight: 450;
    line-height: 1;
    color: var(--ink-3);
  }

  .card__front {
    align-self: center;
    font-size: calc(var(--w) * 0.105);
    font-weight: 420;
    line-height: 1.1;
    letter-spacing: -0.03em;
    white-space: nowrap;
  }

  .card__back {
    display: grid;
    gap: 2px;
    font: 340 max(11px, calc(var(--w) * 0.06)) / 1.25 var(--serif);
    color: var(--ink-2);
    white-space: nowrap;
  }

  .card__back small {
    font: 400 max(10px, calc(var(--w) * 0.046)) / 1.2 var(--sans);
    color: var(--ink-3);
  }

  /* Who made them, under the row. */
  .row__by {
    margin-top: 20px;
    font: 400 var(--size-micro) / 1 var(--mono);
    letter-spacing: 0.02em;
    color: var(--ink-3);
  }

  .row__by span {
    color: var(--ink);
  }

  .ai__words {
    display: grid;
    justify-items: start;
    gap: 14px;
    padding-bottom: 0.5em;
  }

  .ai__link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: var(--size-small);
    font-weight: 500;
  }

  .ai__link :global(svg) {
    width: 15px;
    height: 15px;
  }

  @media (width < 1200px) {
    .ai__head {
      grid-template-columns: minmax(0, 1fr);
    }

    .ai__words {
      max-width: 30rem;
    }
  }

  /*
   * Short of the widest screens, five places reach past both edges all the while the row slides in and is carried
   * along: its first and last, as it's ordered now, aren't drawn.
   */
  @media (width < 1800px) {
    .row {
      --n: 5;
    }

    .card:first-child,
    .card:last-child {
      display: none;
    }
  }

  /* On a smaller screen, the middle card wider, its neighbours showing at the edges. */
  @media (width < 1024px) {
    .row__places {
      --w: 57cqw;
    }
  }

  @media (width < 560px) {
    .row__places {
      --w: 66cqw;
    }

    .card {
      aspect-ratio: 5 / 4;
    }
  }
</style>
