---
import { collection, dealt, finale } from "../content/cards";
import { Stack } from "../motion/stack";

/**
 * Big collections. A deck of cards stands upright at the foot of the screen, facing the viewer, and cards come to it
 * from beyond the screen's top corners: a few at first, then faster and faster until dozens are in the air at once,
 * each slowing as it comes and settling onto the deck's face, which eases back to take it. The count beside climbs
 * to tens of thousands and blurs into infinity. The scenery draws all that (motion/scenery/pile.ts), where the still
 * deck here stands, sized and set as its cards are; without it the still deck shows, stacked, seen as the scenery
 * sees its deck (Stack), each card sized and shaded by /places.css.
 */
const number = new Intl.NumberFormat("en");
const stack = new Stack();
// The still deck as the stacking leaves it, back to front: blank cards behind, as nothing of their faces shows, then a
// card the scenery takes the type of the deck's cards from, and the last card in front.
const resting = [
  ...Array.from({ length: stack.depth - 1 }, (_, index) => ({ depth: stack.depth - index, card: null })),
  { depth: 1, card: dealt[0] ?? finale },
  { depth: 0, card: finale },
];
---

<section class="pile" id="collection" aria-labelledby="pile-title" data-mood="collection">
  <div class="pile__screen">
    <div class="container pile__head">
      <div class="pile__words">
        <h2 id="pile-title" class="heading" data-reveal="words">
          Every flashcard feature. <em>Free.</em>
        </h2>
        <p class="lead" data-reveal="lines">
          The ultimate flashcards app — native on every device, and on the web. Everything Anki does, offline, synced in the background, with AI built in.
        </p>
      </div>
      <p class="pile__count" aria-hidden="true" data-reveal="fade">
        <b class="pile__number">
          <span class="pile__room">{number.format(collection)}</span>
          <span data-pile-count>{number.format(collection)}</span>
          <span class="pile__infinity" data-pile-infinity>
            ∞
          </span>
        </b>
        <span>cards</span>
      </p>
    </div>

    <div class="pile__stage" aria-hidden="true" data-pile>
      <i class="pile__floor"></i>
      <div class="pile__deck" data-pile-deck></div>
      {resting.map(({ card, depth }) =>
        card == null ? (
          <i class="pile-card" data-pile-card={depth}></i>
        ) : (
          <div
            class:list={["pile-card", { "pile-card--last": depth === 0 }]}
            data-pile-card={depth}
            data-pile-sizer={depth === 1 ? "" : undefined}
            data-pile-sizer-last={depth === 0 ? "" : undefined}
          >
            <span class="pile-card__deck" data-part="deck">
              {card.deck}
            </span>
            <span class="pile-card__front" lang={card.lang} data-part="front">
              {card.front}
            </span>
            <span class="pile-card__back" lang={card.lang} data-part="back">
              {card.back}
            </span>
          </div>
        ),
      )}
    </div>
  </div>
</section>

<script>
  import { pile } from "../motion/pile";
  import { scene } from "../motion/scenes";

  scene("[data-pile]", pile);
</script>

<style>
  .pile {
    --card-w: clamp(240px, min(38vw, var(--screen-safe) * 0.54), 540px);
    --card-h: calc(var(--card-w) * 0.66);
    --foot: clamp(40px, 1rem + 4vw, 96px);
    position: relative;
    overflow-x: clip;
  }

  /*
   * At least a screen: the words at the top, the deck standing at the foot, its room kept under the words so the two
   * never meet; taller where the words need more.
   */
  .pile__screen {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr;
    min-height: var(--screen-safe);
    padding-top: calc(var(--nav) + clamp(16px, 0.5rem + 2.5vw, 56px));
  }

  /* The deck's room: a card's height, the floor under it, and a little air above. */
  .pile__screen::after {
    content: "";
    min-height: calc(var(--card-h) + var(--foot) + 24px);
  }

  /* The words and the count side by side, the count's figures as big as headlines. */
  .pile__head {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: clamp(24px, 4vw, 64px);
  }

  .pile__words {
    display: grid;
    justify-items: start;
    gap: clamp(18px, 0.85rem + 0.8vw, 28px);
  }

  .pile__words .lead {
    max-width: 30em;
  }

  .pile__count {
    display: grid;
    justify-items: end;
    line-height: 0.9;
  }

  /* The count as it climbs, in room kept for the whole collection, so the words beside it never move. */
  .pile__number {
    display: grid;
    justify-items: end;
    font-size: clamp(3.25rem, 1.8rem + 6vw, 8.5rem);
    font-weight: 300;
    letter-spacing: -0.055em;
    font-variant-numeric: tabular-nums;
  }

  .pile__number > span {
    grid-area: 1 / 1;
  }

  .pile__room {
    visibility: hidden;
  }

  /* What the count becomes once the whole collection is in: the motion blurs one into the other. */
  .pile__infinity {
    opacity: 0;
  }

  .pile__count > span {
    margin-top: 8px;
    font-size: var(--size-lead);
    color: var(--ink-3);
  }

  /* Where the deck stands: the foot of the section, its middle. */
  .pile__stage {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }

  .pile__deck,
  .pile-card {
    position: absolute;
    left: 50%;
    bottom: var(--foot);
    width: var(--card-w);
    height: var(--card-h);
    margin-left: calc(var(--card-w) / -2);
  }

  /* The floor the deck stands on: a soft shadow under it, which deepens as the deck fills. */
  .pile__floor {
    position: absolute;
    left: 50%;
    bottom: calc(var(--foot) - var(--card-h) * 0.12);
    width: calc(var(--card-w) * 1.7);
    height: calc(var(--card-h) * 0.3);
    margin-left: calc(var(--card-w) * -0.85);
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(30 40 80 / 22%), transparent);
    filter: blur(6px);
    opacity: 0.4;
  }

  /*
   * A card of the deck, seen as far back as it stands: smaller by --scale toward where the deck's edges run to,
   * --horizon card heights above its middle, so the edges of those behind show over the front card as the deck's top,
   * and darkened by --shade toward the shadows' blue.
   */
  .pile-card {
    display: grid;
    grid-template-rows: auto 1fr auto;
    padding: calc(var(--card-w) * 0.06) calc(var(--card-w) * 0.07);
    border-radius: calc(var(--card-w) * 0.06);
    background: linear-gradient(170deg, #fff 35%, #f6f7fa);
    box-shadow:
      0 0 0 100vmax rgb(30 40 80 / var(--shade)) inset,
      0 1px 0 #fff inset,
      0 0 0 1px rgb(11 11 13 / 6%);
    text-align: center;
    transform: scale(var(--scale));
    transform-origin: 50% calc(50% - var(--horizon) * 100%);
  }

  .pile-card--last {
    box-shadow:
      0 1px 0 #fff inset,
      0 0 0 1px rgb(11 11 13 / 6%),
      0 14px 30px -18px rgb(30 40 80 / 36%);
  }

  .pile-card__deck {
    justify-self: start;
    font-size: calc(var(--card-w) * 0.042);
    font-weight: 450;
    line-height: 1;
    color: var(--ink-3);
  }

  .pile-card__front {
    align-self: center;
    font-size: calc(var(--card-w) * 0.1);
    font-weight: 420;
    line-height: 1.1;
    letter-spacing: -0.03em;
    white-space: nowrap;
  }

  .pile-card__back {
    font: 340 calc(var(--card-w) * 0.05) / 1.2 var(--serif);
    color: var(--ink-3);
    white-space: nowrap;
  }

  .pile-card--last .pile-card__front {
    font-family: var(--serif);
    font-size: calc(var(--card-w) * 0.13);
    font-style: normal;
    font-weight: 300;
  }

  .pile-card--last .pile-card__back {
    font: 450 calc(var(--card-w) * 0.04) / 1.2 var(--mono);
    letter-spacing: 0.32em;
  }

  /*
   * With the motion coming (base.css), the still deck makes way for the scenery's, laid out still for it to measure;
   * it shows only where the scenery doesn't (.is-still), the count then gone to infinity.
   */
  :global(html[data-motion]:not([data-motion="off"])) .pile:not(.is-still) .pile__stage {
    visibility: hidden;
  }

  .pile.is-still [data-pile-count] {
    opacity: 0;
  }

  .pile.is-still .pile__infinity {
    opacity: 1;
  }

  @media (width < 760px) {
    .pile__head {
      grid-template-columns: minmax(0, 1fr);
    }

    .pile__count,
    .pile__number {
      justify-items: start;
    }
  }
</style>
