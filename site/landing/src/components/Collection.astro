---
import { collection, dealt, finale, type Flashcard } from "../content/cards";
import Kicker from "./Kicker.astro";

/**
 * Big collections. A deck of cards stands upright at the foot of the screen, facing the viewer, and cards come to it
 * from beyond the screen's top corners: a few at first, then faster and faster until dozens are in the air at once,
 * each slowing as it comes and settling onto the deck's face, which grows thicker behind them. The count beside
 * climbs to tens of thousands (motion/pile.ts). Without the motion the deck is simply there, stacked.
 */
const number = new Intl.NumberFormat("en");
// Enough cards to fill the air at the busiest moment, the collection's in turn; the last card ends it.
const cards: { card: Flashcard; rest?: number; last?: true }[] = [
  ...Array.from({ length: 104 }, (_, index) => ({ card: dealt[index % dealt.length] ?? finale })),
  { card: finale, rest: 0, last: true },
];
// The cards under the last one, as the deck rests without the motion.
for (const [index, depth] of [cards.length - 2, cards.length - 3, cards.length - 4].entries()) {
  const resting = cards[depth];
  if (resting != null) resting.rest = index + 1;
}
---

<section class="pile" id="collection" aria-labelledby="pile-title" data-mood="collection">
  <div class="container pile__head">
    <div class="pile__words">
      <Kicker>Big collections</Kicker>
      <h2 id="pile-title" class="heading" data-reveal="words">
        Every card you have. <em>Not a stutter.</em>
      </h2>
      <p class="lead" data-reveal="lines">
        Rondo keeps your whole collection in a database on your device and answers from it, never from a server, so tens
        of thousands of cards open, search and study without a wait.
      </p>
    </div>
    <p class="pile__count" aria-hidden="true" data-reveal="fade">
      <b class="pile__number">
        <span class="pile__room">{number.format(collection)}</span>
        <span data-pile-count>{number.format(collection)}</span>
      </b>
      <span>cards</span>
    </p>
  </div>

  <div class="pile__stage" aria-hidden="true" data-pile>
    <i class="pile__floor" data-pile-floor></i>
    <div class="pile__deck">
      <div class="pile__block" data-pile-block>
        <i class="pile__top"></i>
        <i class="pile__side"></i>
      </div>
    </div>
    {cards.map(({ card, rest, last }) => (
      <div class:list={["pile-card", { "pile-card--last": last }]} data-pile-card data-rest={rest}>
        <span class="pile-card__deck">{card.deck}</span>
        <span class="pile-card__front" lang={card.lang}>
          {card.front}
        </span>
        <span class="pile-card__back" lang={card.lang}>
          {card.back}
        </span>
      </div>
    ))}
  </div>
</section>

<script>
  import { Pile } from "../motion/pile";
  import { scene } from "../motion/scenes";

  scene("[data-pile]", (root, stage) => new Pile(root, stage));
</script>

<style>
  /* One screen: the words at the top, the deck standing at the foot. */
  .pile {
    --card-w: clamp(200px, min(25vw, 38vh), 360px);
    --card-h: calc(var(--card-w) * 0.66);
    --foot: clamp(40px, 8vh, 96px);
    position: relative;
    height: 100svh;
    min-height: 640px;
    padding-top: calc(var(--nav) + clamp(16px, 5vh, 56px));
    overflow-x: clip;
  }

  /* The words and the count side by side, the count's figures as big as headlines. */
  .pile__head {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: clamp(24px, 4vw, 64px);
  }

  .pile__words {
    display: grid;
    justify-items: start;
    gap: clamp(18px, 2.6vh, 28px);
  }

  .pile__words .lead {
    max-width: 30em;
  }

  .pile__count {
    display: grid;
    justify-items: end;
    line-height: 0.9;
  }

  /* The count as it climbs, in room kept for the whole collection, so the words beside it never move. */
  .pile__number {
    display: grid;
    justify-items: end;
    font-size: clamp(3.25rem, 1.8rem + 6vw, 8.5rem);
    font-weight: 300;
    letter-spacing: -0.055em;
    font-variant-numeric: tabular-nums;
  }

  .pile__number > span {
    grid-area: 1 / 1;
  }

  .pile__room {
    visibility: hidden;
  }

  .pile__count > span {
    margin-top: 8px;
    font-size: var(--size-lead);
    color: var(--ink-3);
  }

  /*
   * Where the deck stands: the foot of the section, its middle. Cards are placed by the motion from the deck's own
   * place, so they start there.
   */
  .pile__stage {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }

  .pile__deck,
  .pile-card {
    position: absolute;
    left: 50%;
    bottom: var(--foot);
    width: var(--card-w);
    height: var(--card-h);
    margin-left: calc(var(--card-w) / -2);
  }

  /*
   * The deck's body behind the cards in front, seen from above and to the right, so its top and its side show every
   * card's edge; the cards in front are flat on its face, so the depth doesn't change them.
   */
  .pile__deck {
    perspective: 560px;
    perspective-origin: 125% -110%;
  }

  .pile__block {
    --thick: 0px;
    position: absolute;
    inset: 0;
    border-radius: calc(var(--card-w) * 0.06);
    background: linear-gradient(170deg, #fff, #f1f2f6);
    box-shadow: 0 0 0 1px rgb(11 11 13 / 7%);
    transform-style: preserve-3d;
    opacity: 0;
  }

  .pile__top,
  .pile__side {
    position: absolute;
  }

  .pile__top {
    left: calc(var(--card-w) * 0.03);
    right: calc(var(--card-w) * 0.03);
    top: 0;
    height: var(--thick);
    transform-origin: 50% 0;
    transform: rotateX(-90deg);
    background:
      linear-gradient(0deg, rgb(30 40 80 / 2%), rgb(30 40 80 / 10%)),
      repeating-linear-gradient(0deg, #fdfdfe 0 2px, #dadde5 2px 3px);
  }

  .pile__side {
    top: calc(var(--card-w) * 0.03);
    bottom: calc(var(--card-w) * 0.03);
    right: 0;
    width: var(--thick);
    transform-origin: 100% 50%;
    transform: rotateY(-90deg);
    background:
      linear-gradient(90deg, rgb(30 40 80 / 14%), rgb(30 40 80 / 6%)),
      repeating-linear-gradient(90deg, #fbfbfd 0 2px, #d3d7df 2px 3px);
  }

  /* The floor the deck stands on: a soft shadow under it, which deepens as the deck fills. */
  .pile__floor {
    position: absolute;
    left: 50%;
    bottom: calc(var(--foot) - var(--card-h) * 0.12);
    width: calc(var(--card-w) * 1.7);
    height: calc(var(--card-h) * 0.3);
    margin-left: calc(var(--card-w) * -0.85);
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(30 40 80 / 22%), transparent);
    filter: blur(6px);
    opacity: 0.4;
  }

  .pile-card {
    display: grid;
    grid-template-rows: auto 1fr auto;
    padding: calc(var(--card-w) * 0.06) calc(var(--card-w) * 0.07);
    border-radius: calc(var(--card-w) * 0.06);
    background: linear-gradient(170deg, #fff 35%, #f6f7fa);
    box-shadow:
      0 0 0 1px rgb(11 11 13 / 6%),
      0 1px 0 #fff inset,
      0 14px 30px -18px rgb(30 40 80 / 36%);
    text-align: center;
    opacity: 0;
    will-change: transform, opacity;
  }

  .pile-card__deck {
    justify-self: start;
    font-size: calc(var(--card-w) * 0.042);
    font-weight: 450;
    line-height: 1;
    color: var(--ink-3);
  }

  .pile-card__front {
    align-self: center;
    font-size: calc(var(--card-w) * 0.1);
    font-weight: 420;
    line-height: 1.1;
    letter-spacing: -0.03em;
    white-space: nowrap;
  }

  .pile-card__back {
    font: italic 340 calc(var(--card-w) * 0.05) / 1.2 var(--serif);
    color: var(--ink-3);
    white-space: nowrap;
  }

  .pile-card--last .pile-card__front {
    font-family: var(--serif);
    font-size: calc(var(--card-w) * 0.13);
    font-style: italic;
    font-weight: 300;
  }

  .pile-card--last .pile-card__back {
    font: 450 calc(var(--card-w) * 0.04) / 1.2 var(--mono);
    letter-spacing: 0.32em;
  }

  /* The deck at rest, as it's left once stacked: what shows without the motion, or before it starts. */
  .pile-card[data-rest="0"] {
    transform: rotate(-0.8deg);
  }

  .pile-card[data-rest="1"] {
    transform: translate(5px, -2px) rotate(2.2deg);
  }

  .pile-card[data-rest="2"] {
    transform: translate(-6px, 2px) rotate(-2.6deg);
  }

  .pile-card[data-rest="3"] {
    transform: translate(3px, 3px) rotate(1.4deg);
  }

  .pile__stage:not(.is-live) .pile-card[data-rest],
  .pile__stage:not(.is-live) .pile__block {
    animation: pile-stacked 0.8s var(--ease-out) 3.4s forwards;
  }

  .pile__stage:not(.is-live) .pile__block {
    --thick: calc(var(--card-w) * 0.3);
  }

  @keyframes pile-stacked {
    to {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pile__stage:not(.is-live) .pile-card[data-rest],
    .pile__stage:not(.is-live) .pile__block {
      opacity: 1;
      animation: none;
    }
  }

  @media (width < 760px) {
    .pile__head {
      grid-template-columns: minmax(0, 1fr);
    }

    .pile__count,
    .pile__number {
      justify-items: start;
    }
  }
</style>
