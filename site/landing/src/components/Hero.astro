---
import { ring } from "../content/cards";
import Actions from "./Actions.astro";
import Countdown from "./Countdown.astro";

/**
 * The first screen: the promise, circled by flashcards like a theme coming back around, those nearer and farther than
 * it blurred out of focus (the scenery draws them, motion/scenery/ring.ts, in the size and type of the hidden card
 * here). Under it, what Rondo is, and the way in: until the launch, the time left and the launch list; then, the apps.
 * The way in scrolls away with the page, as clickable as anything else, rather than fading with the headline.
 */
const [sample] = ring;
---

<section class="hero" aria-labelledby="hero-title" data-hero data-mood="hero">
  {sample && (
    <div class="ring-card" aria-hidden="true" data-ring-sizer>
      <span class="ring-card__front" lang={sample.lang} data-part="front">
        {sample.front}
      </span>
      <span class="ring-card__back" lang={sample.lang} data-part="back">
        {sample.detail ?? sample.back}
      </span>
    </div>
  )}

  <div class="hero__center container">
    <h1 id="hero-title" class="hero__title" data-reveal="hero" data-reveal-manual data-hero-title>
      <span class="hero__line">Remember</span>
      <span class="hero__line">
        <em>for good.</em>
      </span>
    </h1>
    <p class="hero__lead lead" data-reveal="lines" data-reveal-manual>
      Rondo is a free, open-source flashcard app with everything you rely on in Anki. Native on every device, and in
      sync whether you’re online or off.
    </p>
    <div class="hero__entry" data-reveal="fade" data-reveal-manual>
      <div class="hero__when" data-when="pre">
        <Countdown inline />
      </div>
      <Actions name="hero" />
    </div>
  </div>
</section>

<script>
  import { hero } from "../motion/hero";
  import { scene } from "../motion/scenes";

  scene("[data-hero]", hero);
</script>

<style>
  /* At least a screen tall, its words in the middle of what's left under the bar; taller where they need more room. */
  .hero {
    position: relative;
    display: grid;
    align-items: center;
    min-height: var(--screen-safe);
    padding-block: var(--nav) clamp(24px, 1rem + 2vw, 48px);
  }

  /* The ring's cards, as the page sizes and sets them: laid out, for the scenery to measure, but never shown. */
  .ring-card {
    --card-w: clamp(116px, 13.5vw, 214px);
    position: absolute;
    left: 0;
    top: 0;
    display: grid;
    align-content: center;
    row-gap: calc(var(--card-w) * 0.035);
    width: var(--card-w);
    height: calc(var(--card-w) * 0.66);
    padding: calc(var(--card-w) * 0.065) calc(var(--card-w) * 0.075);
    border-radius: calc(var(--card-w) * 0.085);
    visibility: hidden;
    pointer-events: none;
  }

  .ring-card__front {
    justify-self: center;
    font-size: calc(var(--card-w) * 0.13);
    font-weight: 420;
    line-height: 1.1;
    letter-spacing: -0.03em;
    white-space: nowrap;
  }

  .ring-card__back {
    justify-self: center;
    font: 340 calc(var(--card-w) * 0.068) / 1.2 var(--serif);
    color: var(--ink-3);
    white-space: nowrap;
  }

  .hero__center {
    display: grid;
    justify-items: center;
    text-align: center;
  }

  .hero__title {
    font-size: var(--size-hero);
    font-weight: 360;
    line-height: 0.88;
    letter-spacing: -0.055em;
  }

  .hero__line {
    display: block;
  }

  .hero__title em {
    font-family: var(--serif);
    font-style: normal;
    font-weight: 300;
    letter-spacing: -0.035em;
    font-optical-sizing: auto;
  }

  .hero__lead {
    max-width: 30em;
    margin-top: clamp(22px, 1rem + 1vw, 36px);
    font-size: clamp(1rem, 0.95rem + 0.25vw, 1.1875rem);
  }

  .hero__entry {
    display: grid;
    justify-items: center;
    gap: 18px;
    margin-top: clamp(26px, 1.25rem + 1.2vw, 44px);
  }

  .hero__entry :global(.actions__set) {
    justify-content: center;
  }

  .hero__entry :global(.notify__note) {
    padding: 0;
    text-align: center;
  }
</style>
