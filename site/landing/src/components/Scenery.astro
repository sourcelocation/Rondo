---
/**
 * The scenery behind the page (motion/scenery.ts): one canvas, fixed behind everything, that draws the light and,
 * where the page has them, the hero's ring of cards, the collection's deck and the flight. Until it draws, and without
 * it, these gradients stand in for the light, still.
 */
---

<div class="scenery" aria-hidden="true" data-scenery></div>

<style>
  /* As tall as the screen with the browser's toolbars away, so they come and go over it. */
  .scenery {
    position: fixed;
    inset: 0 0 auto;
    height: var(--screen);
    z-index: 0;
    pointer-events: none;
    background:
      radial-gradient(42% 46% at 18% 30%, rgb(169 202 255 / 55%), transparent 70%),
      radial-gradient(38% 42% at 82% 26%, rgb(207 191 255 / 50%), transparent 70%),
      radial-gradient(40% 40% at 70% 82%, rgb(255 203 180 / 45%), transparent 70%),
      radial-gradient(36% 38% at 26% 84%, rgb(180 234 217 / 40%), transparent 70%), var(--paper);
  }

  .scenery.is-drawn {
    background: var(--paper);
  }

  .scenery :global(canvas) {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>
