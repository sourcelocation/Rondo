---
/**
 * The light behind the page: soft colour drifting under everything, strongest at the top and the end. A WebGL
 * shader draws it (motion/aurora.ts); without WebGL, these gradients stand in, still.
 */
---

<div class="aurora" aria-hidden="true" data-aurora></div>

<style>
  .aurora {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background:
      radial-gradient(42% 46% at 18% 30%, rgb(169 202 255 / 55%), transparent 70%),
      radial-gradient(38% 42% at 82% 26%, rgb(207 191 255 / 50%), transparent 70%),
      radial-gradient(40% 40% at 70% 82%, rgb(255 203 180 / 45%), transparent 70%),
      radial-gradient(36% 38% at 26% 84%, rgb(180 234 217 / 40%), transparent 70%), var(--paper);
  }

  .aurora.is-webgl {
    background: var(--paper);
  }

  .aurora :global(canvas) {
    width: 100%;
    height: 100%;
  }
</style>
