---
import { pagePath, pages } from "../content/pages";

/**
 * The curtain the site's pages open through (motion/transition.ts): a sheet of ink with the page's light glowing in
 * it, passing like a wave, each of its edges a lip of glass. Following a link, its front spreads down over the page
 * from the middle of its top, the next page's name rising in its middle; its back, the next page, spreads down
 * through it the same way. As it passes, the motion draws it (motion/transition/wave.ts); standing still, as a page
 * opens under it before its motion comes, it's the sheet here. It shows this page's name, for when this page opens
 * under it. Without JavaScript, or with reduced motion, it never shows; if a page opens under it and its motion
 * doesn't come in time, /head.js takes it away, and it fades.
 */
const label = pages[pagePath(Astro.url.pathname)] ?? "";
---

<div class="curtain" aria-hidden="true" data-curtain>
  <div class="curtain__sheet" data-curtain-sheet>
    <i class="curtain__light"></i>
  </div>
  <canvas class="curtain__wave" data-curtain-wave></canvas>
  <div class="curtain__centre">
    <span class="curtain__label" data-curtain-label>
      {label}
    </span>
  </div>
</div>

<style>
  /* As tall as the screen with the browser's toolbars away, so it covers what's under them too as they come and go. */
  .curtain {
    position: fixed;
    inset: 0 0 auto;
    height: var(--screen);
    z-index: 90;
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
  }

  /* Over a page: "leaving" one, or "cover"ing one that opened under it. */
  :global(html[data-curtain]) .curtain {
    visibility: visible;
    opacity: 1;
    pointer-events: auto;
  }

  /* Taken away because the page's motion didn't come in time (/head.js): it fades. */
  :global(html[data-motion="off"]) .curtain {
    transition:
      opacity 0.6s var(--ease-out),
      visibility 0s 0.6s;
  }

  /* The sheet standing still; the motion draws it in its place as it passes, or fades it where it can't. */
  .curtain__sheet {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: #0d0d12;
  }

  /* The page's four lights, low and soft in the dark. */
  .curtain__light {
    position: absolute;
    inset: -10%;
    background:
      radial-gradient(38% 44% at 18% 24%, rgb(143 180 255 / 34%), transparent 70%),
      radial-gradient(36% 42% at 84% 20%, rgb(196 176 255 / 30%), transparent 70%),
      radial-gradient(40% 40% at 76% 86%, rgb(255 186 160 / 24%), transparent 70%),
      radial-gradient(36% 38% at 22% 88%, rgb(150 224 200 / 22%), transparent 70%);
  }

  /* The sheet as it passes, drawn by the motion, which shows it. */
  .curtain__wave {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    visibility: hidden;
  }

  /* The name, in the middle of what's always seen. */
  .curtain__centre {
    position: absolute;
    inset: 0 0 auto;
    height: var(--screen-safe);
    display: grid;
    place-content: center;
  }

  .curtain__label {
    font-family: var(--serif);
    font-size: clamp(1.5rem, 1.1rem + 1.4vw, 2.5rem);
    font-style: normal;
    font-weight: 300;
    line-height: 1;
    letter-spacing: -0.03em;
    color: rgb(255 255 255 / 86%);
    opacity: 0;
  }

  :global(html[data-curtain="cover"]) .curtain__label {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .curtain {
      display: none;
    }
  }
</style>
