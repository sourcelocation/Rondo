---
import { pagePath, pages } from "../content/pages";

/**
 * The curtain the site's pages open through (motion/transition.ts): a sheet of ink with the page's light glowing in
 * it, passing like a wave, each of its edges a ring of glass. Following a link, its front spreads down over the page
 * from the middle of its top, the next page's name rising in its middle; its back, the next page, spreads down
 * through it the same way. It shows this page's name, for when this page opens under it. Without JavaScript, or with reduced motion, it never shows; if a page opens under it and its
 * motion doesn't come in time, /head.js takes it away, and it fades.
 */
const label = pages[pagePath(Astro.url.pathname)] ?? "";
---

<div class="curtain" aria-hidden="true" data-curtain>
  <div class="curtain__sheet" data-curtain-sheet>
    <i class="curtain__light"></i>
  </div>
  <i class="curtain__ring" data-curtain-front></i>
  <i class="curtain__ring" data-curtain-back></i>
  <div class="curtain__centre">
    <span class="curtain__label" data-curtain-label>
      {label}
    </span>
  </div>
</div>

<style>
  .curtain {
    position: fixed;
    inset: 0;
    z-index: 90;
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
  }

  /* Over a page: "leaving" one, or "cover"ing one that opened under it. */
  :global(html[data-curtain]) .curtain {
    visibility: visible;
    opacity: 1;
    pointer-events: auto;
  }

  /* Taken away because the page's motion didn't come in time (/head.js): it fades. */
  :global(html[data-motion="off"]) .curtain {
    transition:
      opacity 0.6s var(--ease-out),
      visibility 0s 0.6s;
  }

  /* The sheet; as its front spreads or its back opens, the motion masks it to a circle, or to all but one. */
  .curtain__sheet {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: #0d0d12;
  }

  /* The page's four lights, low and soft in the dark. */
  .curtain__light {
    position: absolute;
    inset: -10%;
    background:
      radial-gradient(38% 44% at 18% 24%, rgb(143 180 255 / 34%), transparent 70%),
      radial-gradient(36% 42% at 84% 20%, rgb(196 176 255 / 30%), transparent 70%),
      radial-gradient(40% 40% at 76% 86%, rgb(255 186 160 / 24%), transparent 70%),
      radial-gradient(36% 38% at 22% 88%, rgb(150 224 200 / 22%), transparent 70%);
  }

  /*
   * Each of the sheet's edges as it moves: a ring of glass, bright at its rim, what's under it softened and its colours
   * lifted, a cool fringe outside and a warm one in. The motion sizes and shows it.
   */
  .curtain__ring {
    position: absolute;
    left: 0;
    top: 0;
    width: 0;
    height: 0;
    border-radius: 50%;
    visibility: hidden;
    box-shadow:
      0 0 0 1.5px rgb(255 255 255 / 90%) inset,
      0 0 0 5px rgb(255 120 200 / 10%) inset,
      0 0 22px 5px rgb(255 255 255 / 55%) inset,
      0 0 0 1.5px rgb(96 128 255 / 35%),
      0 6px 30px rgb(30 40 90 / 22%);
  }

  .curtain__ring::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    mask: radial-gradient(farthest-side, transparent calc(100% - 34px), #000 calc(100% - 10px));
    -webkit-backdrop-filter: blur(6px) saturate(1.8) brightness(1.06);
    backdrop-filter: blur(6px) saturate(1.8) brightness(1.06);
  }

  .curtain__centre {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
  }

  .curtain__label {
    font-family: var(--serif);
    font-size: clamp(1.5rem, 1.1rem + 1.4vw, 2.5rem);
    font-style: normal;
    font-weight: 300;
    line-height: 1;
    letter-spacing: -0.03em;
    color: rgb(255 255 255 / 86%);
    opacity: 0;
  }

  :global(html[data-curtain="cover"]) .curtain__label {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .curtain {
      display: none;
    }
  }
</style>
