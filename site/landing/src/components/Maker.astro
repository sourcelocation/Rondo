---
import { Image } from "astro:assets";
import ArrowUpRight from "@lucide/astro/icons/arrow-up-right";
import { links } from "../content/links";
import { projects } from "../content/work";

/**
 * Who makes Rondo, and what they made before: an index of projects whose screenshots follow the pointer
 * (motion/work.ts), and sit in the rows on touch screens.
 */
---

<section class="section maker" id="maker" aria-labelledby="maker-title" data-mood="maker">
  <div class="container maker__grid">
    <div class="maker__intro">
      <p class="kicker" data-reveal="fade">
        <span class="kicker__index">05</span>The maker
      </p>
      <h2 id="maker-title" class="heading" data-reveal="words">
        Made by someone <em>who ships.</em>
      </h2>
      <p class="lead" data-reveal="lines">
        Rondo is built by{" "}
        <a class="link maker__name" href={links.maker}>
          sourcelocation
        </a>
        , a developer with ten years of building platforms for hundreds of thousands of people. Two of them:
      </p>
    </div>

    <ul class="work" data-work>
      {projects.map((project, index) => (
        <li class="work__item" data-reveal="fade">
          <a class="work__link" href={project.url} data-work-link={index}>
            <span class="work__index">{`0${index + 1}`}</span>
            <span class="work__name">{project.name}</span>
            <span class="work__summary">{project.summary}</span>
            <span class="work__facts">
              {project.facts.map((fact) => (
                <span>{fact}</span>
              ))}
            </span>
            <span class="work__arrow" aria-hidden="true">
              <ArrowUpRight stroke-width={1.5} />
            </span>
            <Image
              class="work__thumb"
              src={project.image}
              alt={project.alt}
              widths={[480, 800]}
              sizes="(width < 760px) 100vw, 1px"
              loading="lazy"
            />
          </a>
        </li>
      ))}
    </ul>
  </div>

  <div class="preview" aria-hidden="true" data-preview>
    {projects.map((project) => (
      <Image class="preview__image" src={project.image} alt="" widths={[640, 960]} sizes="480px" loading="lazy" />
    ))}
  </div>
</section>

<style>
  .maker__grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(48px, 6vw, 112px);
    align-items: end;
  }

  .maker__intro {
    display: grid;
    gap: clamp(20px, 3vh, 32px);
    justify-items: start;
  }

  .maker__intro .lead {
    max-width: 26em;
  }

  .maker__name {
    color: var(--ink);
  }

  .work {
    border-top: 1px solid var(--line-2);
  }

  .work__item {
    border-bottom: 1px solid var(--line-2);
  }

  .work__link {
    position: relative;
    display: grid;
    grid-template-columns: 48px 1fr auto;
    grid-template-areas:
      "index name arrow"
      "index summary arrow"
      "index facts arrow";
    column-gap: 16px;
    row-gap: 6px;
    padding: clamp(28px, 4vh, 40px) 0;
    text-decoration: none;
    transition: opacity 0.5s var(--ease-out);
  }

  .work:hover .work__link:not(:hover) {
    opacity: 0.35;
  }

  .work__index {
    grid-area: index;
    padding-top: 1.05em;
    font-size: 13px;
    font-variant-numeric: tabular-nums;
    color: var(--ink-3);
  }

  .work__name {
    grid-area: name;
    font-size: clamp(2rem, 1.3rem + 2.4vw, 3.5rem);
    font-weight: 380;
    line-height: 1.05;
    letter-spacing: -0.045em;
    transition: transform 0.8s var(--ease-out);
  }

  .work__link:hover .work__name {
    transform: translateX(10px);
  }

  .work__summary {
    grid-area: summary;
    font-size: var(--size-lead);
    color: var(--ink-2);
  }

  .work__facts {
    grid-area: facts;
    display: flex;
    flex-wrap: wrap;
    gap: 6px 24px;
    margin-top: 10px;
    font-size: var(--size-small);
    font-variant-numeric: tabular-nums;
    color: var(--ink-3);
  }

  .work__arrow {
    grid-area: arrow;
    align-self: center;
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    box-shadow: 0 0 0 1px var(--line-2) inset;
    transition:
      background-color 0.5s var(--ease-out),
      color 0.5s var(--ease-out),
      transform 0.8s var(--ease-out);
  }

  .work__arrow :global(svg) {
    width: 22px;
    height: 22px;
  }

  .work__link:hover .work__arrow {
    background: var(--ink);
    color: var(--paper);
    transform: rotate(45deg);
  }

  .work__link :global(.work__thumb) {
    display: none;
  }

  .preview {
    position: fixed;
    left: 0;
    top: 0;
    z-index: 40;
    width: 400px;
    aspect-ratio: 16 / 10;
    border-radius: 18px;
    overflow: hidden;
    pointer-events: none;
    opacity: 0;
    box-shadow: var(--shadow-2);
    transform-origin: 100% 50%;
    will-change: transform, opacity, filter;
  }

  .preview :global(.preview__image) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transform: scale(1.12);
    transition:
      opacity 0.5s var(--ease-out),
      transform 1.2s var(--ease-out);
  }

  .preview :global(.preview__image.is-current) {
    opacity: 1;
    transform: none;
  }

  @media (width < 960px) {
    .maker__grid {
      grid-template-columns: 1fr;
    }
  }

  @media (hover: none), (width < 760px) {
    .preview {
      display: none;
    }

    .work__link {
      grid-template-columns: 1fr auto;
      grid-template-areas:
        "thumb thumb"
        "name arrow"
        "summary arrow"
        "facts facts";
    }

    .work__index {
      display: none;
    }

    .work__link :global(.work__thumb) {
      grid-area: thumb;
      display: block;
      width: 100%;
      height: auto;
      margin-bottom: 18px;
      border-radius: 16px;
      box-shadow: 0 0 0 1px var(--line);
    }

    .work:hover .work__link:not(:hover) {
      opacity: 1;
    }
  }
</style>
