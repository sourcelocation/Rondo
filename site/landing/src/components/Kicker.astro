---
/**
 * A section's number and name, a hairline between them. Sections number themselves, in the order they're on the
 * page (a CSS counter the page's <main> resets), so moving one renumbers the rest.
 */
---

<p class="kicker" data-reveal="fade">
  <span class="kicker__index" aria-hidden="true"></span>
  <slot />
</p>
