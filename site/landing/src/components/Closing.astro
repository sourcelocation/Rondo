---
import Actions from "./Actions.astro";

/** The last word: an invitation in, with the light coming back up behind it. */
---

<section class="closing" aria-labelledby="closing-title" data-mood="closing">
  <div class="container closing__inner" data-depth="0.06">
    <h2 id="closing-title" class="closing__title" data-reveal="words">
      Start <em>remembering.</em>
    </h2>
    <p class="lead" data-reveal="lines">
      Free and open source. Bring your Anki decks along.
    </p>
    <div class="closing__actions" data-reveal="fade">
      <Actions name="closing" />
    </div>
  </div>
</section>

<style>
  .closing {
    position: relative;
    padding-block: clamp(120px, 5rem + 9vw, 260px) clamp(100px, 4rem + 7vw, 200px);
  }

  .closing__inner {
    display: grid;
    justify-items: center;
    gap: clamp(24px, 1rem + 1.4vw, 40px);
    text-align: center;
  }

  .closing__title {
    font-size: clamp(3.5rem, 1.6rem + 7.6vw, 10rem);
    font-weight: 360;
    line-height: 0.92;
    letter-spacing: -0.055em;
  }

  .closing__title em {
    font-family: var(--serif);
    font-style: normal;
    font-weight: 300;
    letter-spacing: -0.035em;
  }

  .closing__actions :global(.actions__set) {
    justify-content: center;
  }

  .closing__actions :global(.notify__note) {
    padding: 0;
    text-align: center;
  }
</style>
