{
  "name": "rondo-site",
  "version": "1.0.0",
  "private": true,
  "description": "Rondo's public site at rondo.matthewsource.com: the landing (landing/) at / and the docs (docs/) under /docs, each served by an image of its own (its Dockerfile and Caddyfile). Each is a package of the repository's workspace; they share only lint and format settings.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @rondo/landing dev",
    "dev:docs": "pnpm --filter @rondo/docs dev",
    "lint": "eslint --max-warnings 0 .",
    "typecheck": "pnpm --filter @rondo/landing --filter @rondo/docs --if-present run typecheck",
    "build": "pnpm --filter @rondo/landing --filter @rondo/docs --if-present run build",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "5.28.2",
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.5",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "typescript": "7.0.2",
    "typescript-eslint": "8.72.0"
  }
}
