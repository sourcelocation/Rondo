{
  "name": "rondo-site",
  "version": "1.0.0",
  "private": true,
  "description": "Rondo's public site at rondo.matthewsource.com: the landing (landing/) at / and the docs (docs/) under /docs, served by one image (Dockerfile, Caddyfile). Each is a package of this workspace; they share only lint and format settings.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @rondo/landing dev",
    "dev:docs": "pnpm --filter @rondo/docs dev",
    "lint": "eslint --max-warnings 0 .",
    "typecheck": "pnpm -r --if-present run typecheck",
    "build": "pnpm -r --if-present run build",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "5.23.5",
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.4",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.1.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0"
  }
}
