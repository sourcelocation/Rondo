# Copy to .env (never committed): compose.yaml and compose.dev.yaml read it, and so does the Go server,
# so any of its settings (S3, Web Push, media quotas) can go here too. These values run Rondo on this
# machine. On a server of your own, change every one marked "Self-hosting" (the docs' "Run your own
# server" walks through it).

# Where Rondo is served from, and its hostname. Self-hosting: https://<your hostname> and the hostname,
# whose DNS points at the server, with tls in COMPOSE_PROFILES.
RONDO_PUBLIC_URL=http://localhost:23900
RONDO_HOST=localhost
# The release every image comes from (https://github.com/sourcelocation/Rondo/releases); empty, compose
# builds this checkout.
RONDO_VERSION=
# mail: Mailpit catches the mail (http://localhost:23908). tls: Caddy serves RONDO_HOST over HTTPS on
# ports 80 and 443. s3: local S3-compatible storage. Self-hosting: tls.
COMPOSE_PROFILES=mail
# Kratos and Hydra over plain HTTP. Self-hosting: empty.
ORY_DEV=--dev

# Development secrets, public. Self-hosting: make each with `openssl rand -hex 32`, except
# KRATOS_CIPHER_SECRET, which must be 32 characters: `openssl rand -hex 16`.
POSTGRES_PASSWORD=rondo
RONDO_HOOK_SECRET=dev-hook-secret
KRATOS_COOKIE_SECRET=dev-cookie-secret-not-for-production
KRATOS_CIPHER_SECRET=32-char-dev-cipher-not-for-prod!
HYDRA_SYSTEM_SECRET=dev-hydra-system-secret-not-for-prod

# Sign-in codes go out by email. RONDO_SMTP_TLS is starttls, tls (from the first byte) or none.
# Self-hosting: your SMTP login.
RONDO_SMTP_HOST=mail
RONDO_SMTP_PORT=1025
RONDO_SMTP_TLS=none
RONDO_SMTP_USER=
RONDO_SMTP_PASSWORD=
RONDO_MAIL_FROM=Rondo <hello@rondo.localhost>

# Your own address: once it's signed in and verified, that account holds every staff tool.
RONDO_OWNER_EMAIL=test@test.com
# Staff tools without a passkey; refused outside localhost. Self-hosting: remove it.
RONDO_STAFF_PASSKEY=off
# Web Push for reminders in browsers. Self-hosting: your own (`npx web-push generate-vapid-keys`), or
# remove them.
RONDO_VAPID_PUBLIC_KEY=BCqkX227u3lL38BbiXWaUEPMwU6-iAVZ_LLWp3iPSVHyymFulgJxpNbs02X3xtDm9J2KN6fIVI0w5m--lVVdJGU
RONDO_VAPID_PRIVATE_KEY=pbyWgnVUlRv2ng1gBLXEbtR0wn526AK5BVXvBy_Mwkk
