# The Go server's development settings, beyond its defaults: compose's api service reads them (and
# points the hosts at its containers), and on the host `set -a; . dev/api.env; set +a` exports them.
RONDO_DATABASE_URL="postgres://rondo:rondo@localhost:23903/rondo?sslmode=disable"
RONDO_HYDRA_ADMIN_URL="http://localhost:23907"
# Kratos's webhooks send it (dev/kratos/kratos.yml): without it, no account is made and no code is mailed.
RONDO_HOOK_SECRET=dev-hook-secret
RONDO_MEDIA_DIR=/tmp/rondo-media
RONDO_MAIL_FROM="Rondo <hello@rondo.localhost>"
# The owner's account, and staff tools without a passkey (refused outside localhost).
RONDO_OWNER_EMAIL=test@test.com
RONDO_STAFF_PASSKEY=off
# Web Push for reminders in browsers: development keys only.
RONDO_VAPID_PUBLIC_KEY=BCqkX227u3lL38BbiXWaUEPMwU6-iAVZ_LLWp3iPSVHyymFulgJxpNbs02X3xtDm9J2KN6fIVI0w5m--lVVdJGU
RONDO_VAPID_PRIVATE_KEY=pbyWgnVUlRv2ng1gBLXEbtR0wn526AK5BVXvBy_Mwkk
