{
  "$id": "https://rondo.matthewsource.com/schemas/user.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Rondo user",
  "type": "object",
  "properties": {
    "traits": {
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 254,
          "ory.sh/kratos": {
            "credentials": { "code": { "identifier": true, "via": "email" }, "passkey": { "display_name": true } },
            "verification": { "via": "email" }
          }
        }
      },
      "required": ["email"],
      "additionalProperties": false
    }
  }
}
