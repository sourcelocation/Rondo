# Rondo on your own server: copy this file to .env and fill it in. Make each secret with
# `openssl rand -hex 32`, except the cipher, which must be 32 characters: `openssl rand -hex 16`.

# The hostname Rondo is served from, without https://. Its DNS must point at this server.
RONDO_HOST=rondo.example.com
# The release every image comes from: https://github.com/sourcelocation/Rondo/releases
RONDO_VERSION=v0.1.2

POSTGRES_PASSWORD=
RONDO_HOOK_SECRET=
KRATOS_COOKIE_SECRET=
KRATOS_CIPHER_SECRET=
HYDRA_SYSTEM_SECRET=

# Sign-in codes go out by email. RONDO_SMTP_TLS is starttls, tls (from the first byte) or none.
RONDO_SMTP_HOST=smtp.example.com
RONDO_SMTP_PORT=587
RONDO_SMTP_TLS=starttls
RONDO_SMTP_USER=
RONDO_SMTP_PASSWORD=
RONDO_MAIL_FROM=Rondo <rondo@example.com>

# Your own address: once it's signed in and verified, that account holds every staff tool.
RONDO_OWNER_EMAIL=
